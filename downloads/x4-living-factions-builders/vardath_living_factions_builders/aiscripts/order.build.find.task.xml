<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- X4 9.00 native FindBuildTasks accepts default=false; unlike a mutable
       check_value XPath this selector is stable with other builder extensions. -->
  <replace sel="//param[@name='playeronly']/@default">false</replace>
  <!-- Reject NPC employers without player docking permissions. -->
  <add sel="//handler[@comment='Requested for build']/conditions/event_object_signalled" pos="after">
    <check_value value="not this.ship.isplayerowned or event.param2.isplayerowned or (event.param2.container.exists and event.param2.container.trueowner.hasrelation.dock.{faction.player})"/>
  </add>
</diff>
