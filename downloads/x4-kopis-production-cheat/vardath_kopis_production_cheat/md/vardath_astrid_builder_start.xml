<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VardathAstridBuilderStart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Startup cue: avoid unreliable primaryship and gamestart comparisons. -->
    <cue name="AddAstridEscort" checkinterval="5s">
      <conditions>
        <check_value value="player.age ge 10s and player.zone.exists"/>
      </conditions>
      <actions>
        <debug_text text="\'Vardath Astrid startup cue reached\'" filter="general"/>
        <create_ship name="$Astrid" macro="macro.ship_gen_m_yacht_01_a_macro" zone="player.zone">
          <owner exact="faction.player"/>
          <pilot faction="yaki" tags="fighterpilot"/>
          <people people="player_yaki_veteran_freighter_crew" fillpercent="85"/>
        </create_ship>
      </actions>
    </cue>
  </cues>
</mdscript>
