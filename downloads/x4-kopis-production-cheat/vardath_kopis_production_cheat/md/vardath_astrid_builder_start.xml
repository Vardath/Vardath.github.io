<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VardathAstridBuilderStart"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- v1.03: saved games may have completed the old one-shot AddAstridEscort
         cue, so use a NEW cue name. Reset after every pass to run forever. -->
    <cue name="MaintainPlayerAstrid_v103" instantiate="true" checkinterval="1min">
      <conditions>
        <check_value value="player.age ge 10s and player.ship.exists and player.sector.exists"/>
      </conditions>
      <actions>
        <!-- Search the whole galaxy, not just the current sector. Check true
             ownership so bought, captured, stored and relocated Astrids count.
             Do not filter for operational or undocked ships. -->
        <find_ship_by_true_owner name="$PlayerAstrids"
                                 faction="faction.player"
                                 macro="macro.ship_gen_m_yacht_01_a_macro"
                                 space="player.galaxy"
                                 recursive="true"
                                 multiple="true"/>
        <!-- No Astrid in player ownership: issue exactly ONE replacement.
             A subsequent pass will find the new ship, preventing duplicates.
             The next lost/sold/transferred Astrid triggers another replacement. -->
        <do_if value="$PlayerAstrids.count == 0">
          <create_ship name="$Astrid"
                       macro="macro.ship_gen_m_yacht_01_a_macro"
                       sector="player.sector">
            <owner exact="faction.player" overridenpc="true"/>
            <pilot>
              <select faction="faction.yaki" tags="tag.fighterpilot"/>
            </pilot>
            <people ref="player_yaki_veteran_freighter_crew">
              <fillpercent exact="85"/>
            </people>
            <!-- Engine-supported collision-safe spawn near the player's ship. -->
            <safepos object="player.ship" exact="3km"/>
          </create_ship>
          <debug_text text="'Vardath Astrid: replacement player-owned Yaki-crewed Astrid spawned near player'" filter="general"/>
        </do_if>
        <reset_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
