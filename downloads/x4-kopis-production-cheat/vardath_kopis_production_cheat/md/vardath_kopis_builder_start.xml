<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VardathKopisBuilderStart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Startup cue: avoid unreliable primaryship and gamestart comparisons. -->
    <cue name="AddKopisEscort" checkinterval="5s">
      <conditions>
        <check_value value="player.age ge 10s and player.zone.exists"/>
      </conditions>
      <actions>
        <set_value name="$StartZone" exact="player.zone"/>
        <debug_text text="\'Vardath Kopis startup cue reached\'" filter="general"/>
        <create_ship name="$Forge" macro="macro.ship_vardath_kopis_factory_macro" zone="$StartZone">
          <owner exact="faction.player"/>
          <loadout>
            <macros>
              <engine macro="engine_ter_s_allround_01_mk2_macro" path="../con_engine_01"/>
              <shield macro="shield_ter_s_standard_01_mk2_macro" path="../con_shield_01"/>
              <weapon macro="weapon_vardath_kopis_laser_macro" path="../con_weapon_01"/>
            </macros>
            <groups>
              <turrets macro="turret_vardath_kopis_beam_macro" group="group_vardath_dorsal" exact="1"/>
            </groups>
            <virtualmacros>
              <thruster macro="thruster_gen_s_allround_01_mk2_macro"/>
            </virtualmacros>
          </loadout>
          <pilot><select faction="yaki" tags="fighterpilot"/></pilot>
          <people ref="player_yaki_veteran_freighter_crew"><fillpercent exact="85"/></people>
        </create_ship>
      </actions>
    </cue>
  </cues>
</mdscript>
