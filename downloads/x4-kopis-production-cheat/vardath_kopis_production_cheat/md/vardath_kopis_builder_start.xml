<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VardathKopisBuilderStart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Spawn exactly ten player-owned Kopis Forges when the startup cue first fires. -->
    <cue name="AddKopisEscort" checkinterval="5s">
      <conditions>
        <check_value value="player.age ge 10s and player.zone.exists"/>
      </conditions>
      <actions>
        <set_value name="$StartZone" exact="player.zone"/>
        <debug_text text="'Vardath Kopis startup cue reached'" filter="general"/>
        <!-- Independent weapon-only equipment preset avoids reliance on
             any full loadout lookup during ship construction. -->
        <create_loadout result="$VardathWeaponKit">
          <macros>
            <weapon macro="weapon_vardath_kopis_laser_macro" path="../con_weapon_01"/>
          </macros>
        </create_loadout>
        <do_all exact="10" counter="$ForgeIndex">
          <create_ship name="$Forge" macro="macro.ship_vardath_kopis_factory_macro" zone="$StartZone">
          <owner exact="faction.player"/>
          <loadout ref="vardath_kopis_factory_kit"/>
          <pilot><select faction="faction.yaki" tags="tag.fighterpilot"/></pilot>
          <people ref="player_yaki_veteran_freighter_crew"><fillpercent exact="4"/></people>
          </create_ship>
          <find_object_component name="$VardathStartWeapons" object="$Forge" class="class.weapon" multiple="true"/>
          <do_if value="$Forge.exists and $VardathStartWeapons.count == 0 and $VardathWeaponKit?">
            <!-- Add only the missing main weapon. Do not touch cargo, engines,
                 shields, crew, drones, or any other equipped objects. -->
            <apply_loadout object="$Forge" loadout="$VardathWeaponKit" flags="add weapons"/>
          </do_if>
        </do_all>
      </actions>
    </cue>
  </cues>
</mdscript>
