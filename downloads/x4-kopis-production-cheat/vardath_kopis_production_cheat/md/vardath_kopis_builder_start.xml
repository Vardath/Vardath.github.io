<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VardathKopisBuilderStart" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Only spawn bonus ships for the Living Factions & Builders custom Terran Yaki builder start. -->
    <cue name="AddKopisEscort" checkinterval="5s">
      <conditions>
        <check_value value="player.age ge 5s and player.zone.exists and player.primaryship.exists and player.primaryship.macro == macro.ship_ter_xl_builder_01_a_macro and player.galaxy.gamestart == 'vardath_gamestart_terran_yaki_builder'"/>
      </conditions>
      <actions>
        <set_value name="$StartZone" exact="player.zone"/>
        <create_ship name="$Forge" macro="macro.ship_vardath_kopis_factory_macro" zone="$StartZone">
          <owner exact="faction.player"/>
          <loadout ref="vardath_kopis_factory_kit"/>
          <pilot faction="yaki" tags="fighterpilot"/>
          <people people="player_yaki_veteran_freighter_crew" fillpercent="85"/>
        </create_ship>
        <!-- Astrid is optional; keep an invalid/unavailable DLC macro from blocking Forge. -->
        <do_if value="macro.ship_pir_m_yacht_01_a_macro.exists">
          <create_ship name="$Astrid" macro="macro.ship_pir_m_yacht_01_a_macro" zone="$StartZone">
            <owner exact="faction.player"/>
            <pilot faction="yaki" tags="fighterpilot"/>
            <people people="player_yaki_veteran_freighter_crew" fillpercent="85"/>
          </create_ship>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
