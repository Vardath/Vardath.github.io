<?xml version="1.0" encoding="utf-8"?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="VardathFactionCamouflage" xsi:noNamespaceSchemaLocation="md.xsd">
  <!-- All player-owned ships: no changes to ship macros, cargo, ownership, crew,
       orders, reputation, combat AI, missions, or engine cover-exposure rules.
       Mod Support APIs (already installed in the user's X4 debug log) supplies
       the stock right-click action and standalone choice menu. -->
  <cues>
    <cue name="OfferDisguiseOnRightClick" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions"/>
      </conditions>
      <actions>
        <set_value name="$Ship" exact="event.param.$object"/>
        <do_if value="typeof $Ship == datatype.component">
          <do_if value="$Ship.exists and $Ship.isclass.ship and $Ship.isoperational and $Ship.trueowner == faction.player">

              <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
                $id='vardath_camouflage_select',
                $section='main',
                $text='Select faction camouflage...',
                $mouseover='Assume a faction identity using the native X4 cover system. Combat and scans can reveal your identity.',
                $callback=OpenFactionMenu
              ]"/>
              <do_if value="$Ship.coverowner">
                <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
                  $id='vardath_camouflage_drop',
                  $section='main',
                  $text='Drop faction camouflage',
                  $mouseover='Return to your true player identity. Native reputation consequences still apply.',
                  $callback=DropCoverFromMap
                ]"/>
              </do_if>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <cue name="OpenFactionMenu" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Ship" exact="event.param.$object"/>
        <do_if value="typeof $Ship == datatype.component">
          <do_if value="$Ship.exists and $Ship.isoperational and $Ship.trueowner == faction.player and $Ship.isclass.ship">
            <set_value name="player.entity.$vfc_selectionship" exact="$Ship"/>
            <!-- Discover installed ship-owning factions. This also includes
                 factions added by other mods if they use the native tag. -->
            <get_factions_by_tag result="$Choices" tag="tag.privateship"/>
            <!-- Cover several vanilla factions which can be non-economic or
                 otherwise lack the standard private-ship tag in some plots. -->
            <do_for_each name="$Extra" in="[faction.argon, faction.antigone, faction.teladi, faction.ministry, faction.paranid, faction.holyorder, faction.trinity, faction.alliance, faction.hatikvah, faction.scaleplate, faction.buccaneers, faction.terran, faction.pioneers, faction.yaki, faction.split, faction.freesplit, faction.court, faction.fallensplit, faction.loanshark, faction.scavenger, faction.xenon, faction.khaak]">
              <do_if value="$Extra and not $Choices.indexof.{$Extra}">
                <append_to_list name="$Choices" exact="$Extra"/>
              </do_if>
            </do_for_each>
            <!-- Reserve only actual faction objects; never allow disguising
                 as player/ownerless/criminal mission placeholder factions. -->
            <set_value name="$Selectable" exact="[]"/>
            <do_for_each name="$Faction" in="$Choices">
              <do_if value="$Faction and $Faction != faction.player and $Faction != faction.ownerless and $Faction != faction.criminal and $Faction != faction.civilian and $Faction != faction.outlaw and $Faction != faction.smuggler and $Faction != faction.visitor and not $Selectable.indexof.{$Faction}">
                <append_to_list name="$Selectable" exact="$Faction"/>
              </do_if>
            </do_for_each>
            <set_value name="player.entity.$vfc_allowedfactions" exact="$Selectable"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Create_Menu" param="table[
              $id='vardath_faction_camouflage_picker',
              $columns=1,
              $title='Faction camouflage: ' + $Ship.knownname,
              $width=660,
              $height=700
            ]"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
              $col=1,
              $text=table[$text='Use my real faction (disable camouflage)'],
              $onClick=DropCoverFromPicker
            ]"/>
            <do_for_each name="$Faction" in="$Selectable">
              <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row"/>
              <signal_cue_instantly cue="md.Simple_Menu_API.Make_Button" param="table[
                $col=1,
                $text=table[$text=$Faction.knownname],
                $mouseOverText='Use native X4 disguise for ' + $Faction.knownname,
                $echo=$Faction,
                $onClick=ApplyCoverFromPicker
              ]"/>
            </do_for_each>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <cue name="ApplyCoverFromPicker" instantiate="true">
      <conditions><event_cue_signalled/></conditions>
      <actions>
        <set_value name="$Ship" exact="@player.entity.$vfc_selectionship"/>
        <set_value name="$Faction" exact="event.param.$echo"/>
        <do_if value="typeof $Ship == datatype.component">
          <do_if value="$Ship.exists and $Ship.isoperational and $Ship.trueowner == faction.player and $Ship.isclass.ship and @player.entity.$vfc_allowedfactions.indexof.{$Faction}">
            <!-- Egosoft's Cover.TriggerCover registers the ship and actors,
                 and preserves the native attack/scan/exposure lifecycle. -->
            <signal_cue_instantly cue="md.Cover.TriggerCover" param="[$Ship, $Faction, false]"/>
            <write_to_logbook category="general" title="'Vardath: Faction camouflage'" text="'%1 requested native cover as %2'.[$Ship.knownname, $Faction.knownname]"/>
          </do_if>
        </do_if>
        <signal_cue_instantly cue="md.Simple_Menu_API.Close_Menu"/>
      </actions>
    </cue>

    <cue name="DropCoverFromMap" instantiate="true">
      <conditions><event_cue_signalled/></conditions>
      <actions>
        <set_value name="$Ship" exact="event.param.$object"/>
        <do_if value="typeof $Ship == datatype.component">
          <do_if value="$Ship.exists and $Ship.isoperational and $Ship.trueowner == faction.player and $Ship.isclass.ship and $Ship.coverowner">
            <signal_cue_instantly cue="md.Cover.TriggerCover" param="[$Ship, faction.player, false]"/>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <cue name="DropCoverFromPicker" instantiate="true">
      <conditions><event_cue_signalled/></conditions>
      <actions>
        <set_value name="$Ship" exact="@player.entity.$vfc_selectionship"/>
        <do_if value="typeof $Ship == datatype.component">
          <do_if value="$Ship.exists and $Ship.isoperational and $Ship.trueowner == faction.player and $Ship.isclass.ship and $Ship.coverowner">
            <signal_cue_instantly cue="md.Cover.TriggerCover" param="[$Ship, faction.player, false]"/>
          </do_if>
        </do_if>
        <signal_cue_instantly cue="md.Simple_Menu_API.Close_Menu"/>
      </actions>
    </cue>
  </cues>
</mdscript>
