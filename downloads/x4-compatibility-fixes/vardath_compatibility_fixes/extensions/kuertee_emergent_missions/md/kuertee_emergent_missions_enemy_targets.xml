<?xml version="1.0" encoding="utf-8"?>
<diff>
  <replace sel="/mdscript//cue[@name='EnemyTargetManager_SetPlayerTarget']/actions/do_if[@value='$RunActions_OrderNPCShip']//sort_group[@group='$EnemyTargets']/@sortbyvalue">            abs($ship.threatscore - (loop.element.threatscore + loop.element.isclass.station * 100))            + loop.element.distanceto.{$ship} / 1000.0            - (@loop.element.toplevelcommander.isclass.ship and @loop.element.toplevelcommander.order.$primarytarget == $ship) * 100</replace>
  <replace sel="/mdscript//cue[@name='EnemyTargetManager_SetPlayerTarget']/actions/do_if[2]/debug_text"><do_if value="@$EnemyTargets.{1}.exists"><debug_text text="'%s $EnemyTargets.{1} %s %s %s'.[$Cue_Mission.$MissionId, $EnemyTargets.{1}, $EnemyTargets.{1}.knownname, $EnemyTargets.{1}.idcode]" chance="[md.Kuertee_emergent_mission_enemy_targets.Manager.$debugChance_enemyTargets, $DebugChance].max"/></do_if></replace>
  <replace sel="/mdscript//cue[@name='EnemyTargetManager_SetPlayerTarget']/actions/do_if[2]/set_player_target"><do_if value="@$EnemyTargets.{1}.exists"><set_player_target object="$EnemyTargets.{1}"/></do_if></replace>
