  <replace sel="/mdscript//cue[@name='EnemyTargetManager_SetPlayerTarget']/actions/do_if[@value='$RunActions_OrderNPCShip']/do_if/do_for_each/do_if/debug_text"><do_if value="@$EnemyTargets.{1}.exists"><debug_text text="'%s $ship %s %s %s $EnemyTargets.{1} %s %s %s'.[$Cue_Mission.$MissionId, $ship, $ship.knownname, $ship.idcode, $EnemyTargets.{1}, $EnemyTargets.{1}.knownname, $EnemyTargets.{1}.idcode]" chance="[md.Kuertee_emergent_mission_enemy_targets.Manager.$debugChance_enemyTargets, $DebugChance].max"/></do_if></replace>
  <replace sel="/mdscript//cue[@name='EnemyTargetManager_SetPlayerTarget']/actions/do_if[@value='$RunActions_OrderNPCShip']//run_actions[@ref='$RunActions_OrderNPCShip']"><do_if value="@$EnemyTargets.{1}.exists"><run_actions ref="$RunActions_OrderNPCShip"><param name="Cue_Mission" value="$Cue_Mission"/><param name="Ship" value="$ship"/><param name="Target" value="$EnemyTargets.{1}"/><param name="IsAttack" value="true"/></run_actions></do_if></replace>
