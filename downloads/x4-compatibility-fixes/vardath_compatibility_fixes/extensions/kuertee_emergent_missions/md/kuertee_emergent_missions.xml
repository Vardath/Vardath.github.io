<?xml version='1.0' encoding='utf-8'?>
<diff>
  <replace sel="/mdscript//run_actions[@ref='Bounties_RegisterPilot']">
    <do_if value="@$attacker.pilot.isclass.npc">
      <run_actions ref="Bounties_RegisterPilot">
        <param name="Pilot" value="$attacker.pilot" />
      </run_actions>
    </do_if>
  </replace>
  <replace sel="/mdscript//run_actions[@ref='Bounties_RegisterKill']">
    <do_if value="@$attacker.pilot.isclass.npc">
      <run_actions ref="Bounties_RegisterKill">
        <param name="Pilot" value="$attacker.pilot" />
        <param name="VictimClass" value="$victimClass" />
        <param name="VictimFaction" value="$victimFaction" />
        <param name="IsSubordinateKill" value="$isSubordinateKill" />
      </run_actions>
    </do_if>
  </replace>
  <!-- KEM: location updates may be called for pilot=computer and for old uninitialised records. -->
  <replace sel="/mdscript//library[@name='Bounties_UpdateLastKnown']/actions/do_if/@value">@$Pilot.isclass.npc and @$Pilot.isoperational and @$Pilot.ship.isoperational and @$Pilot.ship.sector.exists and $Faction</replace>
  <add sel="/mdscript//library[@name='Bounties_UpdateLastKnown']/actions/do_if/do_all" pos="before">
    <do_if value="not @$Pilot.$kEM_lastKnownLocation">
      <set_value name="$Pilot.$kEM_lastKnownLocation" exact="table[]" />
    </do_if>
    <do_if value="not @$Pilot.$kEM_lastKnownLocation.{$Faction}">
      <set_value name="$Pilot.$kEM_lastKnownLocation.{$Faction}" exact="[]" />
    </do_if>
  </add>
  <add sel="/mdscript//library[@name='Bounties_UpdateLastKnown']//do_elseif[@value='$distFromOld gt 10km']" pos="prepend">
    <do_if value="typeof @$Pilot.$kEM_lastKnownLocation.{$Faction}.{1}.$otherPosInArea != datatype.list">
      <set_value name="$Pilot.$kEM_lastKnownLocation.{$Faction}.{1}.$otherPosInArea" exact="[]" />
    </do_if>
  </add>
  <add sel="/mdscript//cue[@name='Bounties_CleanIntervalNow']//do_for_each[@name='$faction_inList']" pos="prepend">
    <do_if value="typeof @$pilot_inList.$kEM_lastKnownLocation.{$faction_inList} != datatype.list">
      <remove_value name="$pilot_inList.$kEM_lastKnownLocation.{$faction_inList}" />
      <continue />
    </do_if>
    <do_if value="not @$pilot_inList.$kEM_lastKnownLocation.{$faction_inList}.{1}.$time">
      <remove_value name="$pilot_inList.$kEM_lastKnownLocation.{$faction_inList}" />
      <continue />
    </do_if>
  </add>
</diff>