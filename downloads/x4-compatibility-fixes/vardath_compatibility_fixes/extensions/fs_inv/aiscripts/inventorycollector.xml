<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- Native handlers expect the conventional debugchance local. The collector
       does not declare it. Also guard loop entry for already-running saves. -->
  <add sel="/aiscript/init" pos="prepend"><do_if value="not $debugchance?"><set_value name="$debugchance" exact="0"/></do_if></add>
  <add sel="/aiscript/attention/actions/label[@name='start']" pos="after"><do_if value="not $debugchance?"><set_value name="$debugchance" exact="0"/></do_if></add>
  <add sel="/aiscript/attention/actions/label[@name='search']" pos="after"><do_if value="not $debugchance?"><set_value name="$debugchance" exact="0"/></do_if></add>
</diff>
