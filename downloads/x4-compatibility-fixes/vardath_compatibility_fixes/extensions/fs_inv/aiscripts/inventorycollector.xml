<?xml version='1.0' encoding='utf-8'?>
<diff>
  <!-- Native handlers expect the conventional debugchance local. The collector
       does not declare it. Also guard loop entry for already-running saves. -->
  <add sel="/aiscript/init" pos="prepend">
    <do_if value="not $debugchance?">
      <set_value name="$debugchance" exact="0" />
    </do_if>
  </add>
  <add sel="/aiscript/attention/actions/label[@name='start']" pos="after">
    <do_if value="not $debugchance?">
      <set_value name="$debugchance" exact="0" />
    </do_if>
  </add>
  <add sel="/aiscript/attention/actions/label[@name='search']" pos="after">
    <do_if value="not $debugchance?">
      <set_value name="$debugchance" exact="0" />
    </do_if>
  </add>
  <add sel="/aiscript/attention/actions/do_all[@counter='$si']/set_value[@name='$ship']" pos="before">
    <do_if value="typeof @$ships != datatype.list">
      <break />
    </do_if>
    <do_if value="$si gt $ships.count">
      <break />
    </do_if>
  </add>
  <add sel="/aiscript/attention/actions/do_all[@counter='$si']/set_value[@name='$ship']" pos="after">
    <do_if value="not @$ship.exists">
      <continue />
    </do_if>
    <do_if value="not @$ship.sector.exists">
      <continue />
    </do_if>
  </add>
</diff>