<?xml version="1.0" encoding="utf-8"?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="VHA_Services" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- V103: Runtime storage-module attachment on ships is unsupported. The old
         V102 retrofit repeatedly failed and tried to treat a docking bay as a
         destructible station module. Capacity must be defined by the ship macro. -->
    <!-- Ship component references do NOT own writable MD state. Run a bounded
         10-minute batch without per-ship component properties or catch-up bursts. -->
    <cue name="ReplenishV103" instantiate="true" checkinterval="10min" namespace="this">
      <conditions>
        <check_value value="player.exists and player.galaxy.exists and player.age ge 10min"/>
      </conditions>
      <actions>
        <find_ship_by_true_owner name="$Ships" faction="faction.player" macro="macro.ship_vardath_hyperion_ascendant_macro" space="player.galaxy" multiple="true"/>
        <do_for_each name="$Ship" in="$Ships">
          <do_if value="$Ship.exists and $Ship.isplayerowned and $Ship.isoperational and $Ship.macro == macro.ship_vardath_hyperion_ascendant_macro">
            <set_value name="$AmmoBefore" exact="$Ship.ammostorage.countermeasure.count + $Ship.ammostorage.deployable.count"/>
            <set_value name="$UnitsBefore" exact="$Ship.units.count"/>
            <!-- Give ships with no construction drones a bounded initial builder kit. -->
            <do_if value="$Ship.units.{unitcategory.build}.count == 0 and $Ship.units.free gt 0">
              <add_units object="$Ship" macro="macro.ship_gen_xs_buildingdrone_01_a_macro" exact="[30, $Ship.units.free].min"/>
            </do_if>
            <do_if value="$Ship.ammostorage.countermeasure.free gt 0">
              <add_ammo object="$Ship" macro="macro.countermeasure_flares_01_macro" amount="[5, $Ship.ammostorage.countermeasure.free].min"/>
            </do_if>
            <do_if value="$Ship.ammostorage.deployable.free gt 0">
              <add_ammo object="$Ship" macro="macro.eq_arg_satellite_02_macro" amount="1"/>
            </do_if>
            <do_if value="$Ship.ammostorage.deployable.free gt 0">
              <add_ammo object="$Ship" macro="macro.eq_arg_resourceprobe_01_macro" amount="1"/>
            </do_if>
            <do_if value="$Ship.ammostorage.deployable.free gt 0">
              <add_ammo object="$Ship" macro="macro.env_deco_nav_beacon_t1_macro" amount="1"/>
            </do_if>
            <do_if value="$Ship.ammostorage.deployable.free gt 0">
              <add_ammo object="$Ship" macro="macro.weapon_gen_mine_03_macro" amount="1"/>
            </do_if>
            <do_if value="$Ship.units.free gt 0">
              <add_units object="$Ship" macro="macro.ship_gen_xs_cargodrone_empty_01_a_macro" exact="1"/>
            </do_if>
            <do_if value="$Ship.units.free gt 0">
              <add_units object="$Ship" macro="macro.ship_gen_xs_buildingdrone_01_a_macro" exact="1"/>
            </do_if>
            <set_value name="$AddedAmmo" exact="$Ship.ammostorage.countermeasure.count + $Ship.ammostorage.deployable.count - $AmmoBefore"/>
            <set_value name="$AddedUnits" exact="$Ship.units.count - $UnitsBefore"/>
            <do_if value="$AddedAmmo gt 0 or $AddedUnits gt 0">
              <debug_text text="'VHA V103 replenishment: %1 +%2 consumables, +%3 drones. No trade cargo or equipment replaced.'.[$Ship.debugname,$AddedAmmo,$AddedUnits]" filter="general"/>
            </do_if>
          </do_if>
        </do_for_each>
        <reset_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
