<?xml version='1.0' encoding='UTF-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="VGO_Turrets" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Init">
      <actions>
        <set_value name="$Ships" exact="[]" />
      </actions>
    </cue>
    <cue name="BootstrapV22">
      <actions>
        <do_if value="not Init.$Ships?">
          <set_value name="Init.$Ships" exact="[]" />
        </do_if>
        <do_if value="not player.entity.$vgo_objects?">
          <set_value name="player.entity.$vgo_objects" exact="table[]" />
        </do_if>
      </actions>
    </cue>
    <!-- Repeats after loading an existing save and after UI/menu reloads. No global ship searches. -->
    <cue name="InstallUI" instantiate="true" checkinterval="10s">
      <conditions>
        <check_value value="player.age ge 0s" />
      </conditions>
      <actions>
        <raise_lua_event name="'VGO.Install'" param="player.entity" />
        <raise_lua_event name="'Vardath.NativeIncome.Install'" param="player.entity" />
      </actions>
    </cue>
    <cue name="Selection" instantiate="true">
      <conditions>
        <event_ui_triggered screen="'VGO'" control="'turretmode'" />
      </conditions>
      <actions>
        <do_if value="not player.entity.$vgo_objects?">
          <set_value name="player.entity.$vgo_objects" exact="table[]" />
        </do_if>
        <set_value name="$ship" exact="event.param3.{1}" />
        <set_value name="$representative" exact="event.param3.{2}" />
        <set_value name="$scope" exact="event.param3.{3}" />
        <set_value name="$on" exact="event.param3.{4}" />
        <do_if value="$ship.isplayerowned and $ship.isclass.[class.ship_s, class.ship_m, class.ship_l, class.ship_xl] and ($scope == 'all' or ($representative.isclass.turret and $representative.hascontext.{$ship}))">
          <do_if value="not player.entity.$vgo_objects.{$ship}?">
            <set_value name="player.entity.$vgo_objects.{$ship}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_crystal_configured" exact="true" />
          <find_object_component name="$turrets" object="$ship" class="class.turret" multiple="true" />
          <do_for_each name="$turret" in="$turrets">
            <do_if value="$scope == 'all' or ($scope == 'turret' and $turret == $representative) or ($scope == 'group' and $turret.grouptag == $representative.grouptag and $turret.parent == $representative.parent)">
              <do_if value="not $turret.isrepairing">
                <do_if value="not player.entity.$vgo_objects.{$turret}?">
                  <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                </do_if>
                <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_minecrystals" exact="$on" />
                <do_if value="$on">
                  <!-- Do not let the native mining controller shoot whole asteroids
                       concurrently with our crystal-only scripted aim/fire. -->
                  <do_if value="not player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode?">
                    <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode" exact="$turret.mode" />
                  </do_if>
                  <set_weapon_mode weapon="$turret" weaponmode="weaponmode.holdfire" />
                </do_if>
                <do_else>
                  <!-- Restore precisely the player's prior turret mode on exit. -->
                  <do_if value="player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode?">
                    <set_weapon_mode weapon="$turret" weaponmode="player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode" />
                    <remove_value name="player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode" />
                  </do_if>
                  <reset_turret turret="$turret" />
                </do_else>
              </do_if>
            </do_if>
          </do_for_each>
          <set_value name="$all" exact="true" />
          <set_value name="$any" exact="false" />
          <do_for_each name="$turret" in="$turrets">
            <do_if value="not $turret.isrepairing">
              <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_minecrystals">
                <set_value name="$any" exact="true" />
              </do_if>
              <do_else>
                <set_value name="$all" exact="false" />
              </do_else>
            </do_if>
          </do_for_each>
          <do_if value="not player.entity.$vgo_objects.{$ship}?">
            <set_value name="player.entity.$vgo_objects.{$ship}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_crystal_all" exact="$any and $all" />
          <do_if value="$any and not Init.$Ships.indexof.{$ship}">
            <append_to_list name="Init.$Ships" exact="$ship" />
          </do_if>
        </do_if>
      </actions>
    </cue>
    <cue name="Controller" instantiate="true" checkinterval="1s">
      <conditions>
        <check_value value="Init.$Ships.count gt 0" />
      </conditions>
      <actions>
        <do_if value="not player.entity.$vgo_objects?">
          <set_value name="player.entity.$vgo_objects" exact="table[]" />
        </do_if>
        <do_for_each name="$ship" in="Init.$Ships" counter="$i" reverse="true">
          <do_if value="not $ship.exists">
            <remove_value name="Init.$Ships.{$i}" />
            <continue />
          </do_if>
          <!-- Autonomous miner has its own movement, firing and collection loop. Never run both. -->
          <do_if value="$ship.isplayerowned and @$ship.order.id == 'VGO_crystal'">
            <continue />
          </do_if>
          <find_object_component name="$turrets" object="$ship" class="class.turret" multiple="true" />
          <set_value name="$selected" exact="[]" />
          <do_for_each name="$turret" in="$turrets">
            <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed and (not $ship.isplayerowned or $ship.attention lt attention.visible or not @player.entity.$vgo_objects.{$turret}.$vgo_minecrystals or not @player.entity.$vgo_objects.{$ship}.$vgo_mode_target.isoperational or @player.entity.$vgo_objects.{$ship}.$vgo_mode_target.sector != $ship.sector or @player.entity.$vgo_objects.{$ship}.$vgo_mode_target_until lt player.age or (@$ship.defaultorder.id == 'VGO_crystal' and @$ship.order.id != 'VGO_crystal'))">
              <reset_turret turret="$turret" />
              <do_if value="not player.entity.$vgo_objects.{$turret}?">
                <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
              </do_if>
              <remove_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed" />
            </do_if>
            <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_minecrystals and not $turret.isrepairing">
              <!-- Upgrade existing saves: preserve old mode once, then suppress
                   native asteroid mining while crystal mode owns the turret. -->
              <do_if value="not player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode?">
                <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_saved_native_mode" exact="$turret.mode" />
              </do_if>
              <do_if value="$turret.mode != weaponmode.holdfire">
                <set_weapon_mode weapon="$turret" weaponmode="weaponmode.holdfire" />
              </do_if>
              <append_to_list name="$selected" exact="$turret" />
            </do_if>
          </do_for_each>
          <do_if value="not $ship.isplayerowned or not $selected.count">
            <remove_value name="Init.$Ships.{$i}" />
            <continue />
          </do_if>
          <!-- Preserve direct-order priority when this is a temporarily interrupted miner. -->
          <do_if value="$ship.attention lt attention.visible or not $ship.sector.exists or @$ship.defaultorder.id == 'VGO_crystal'">
            <continue />
          </do_if>
          <do_if value="$ship.hullpercentage lt 65 or ($ship.maxshield gt 0 and $ship.shieldpercentage lt 25)">
            <do_for_each name="$turret" in="$selected">
              <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed">
                <reset_turret turret="$turret" />
                <do_if value="not player.entity.$vgo_objects.{$turret}?">
                  <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                </do_if>
                <remove_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed" />
              </do_if>
            </do_for_each>
            <continue />
          </do_if>
          <set_value name="$target" exact="@player.entity.$vgo_objects.{$ship}.$vgo_mode_target" />
          <do_if value="not $target.exists or $target.hull le 0 or $target.sector != $ship.sector or player.age gt @player.entity.$vgo_objects.{$ship}.$vgo_mode_target_until">
            <do_if value="@player.entity.$vgo_objects.{$ship}.$vgo_mode_search gt player.age">
              <continue />
            </do_if>
            <do_if value="not player.entity.$vgo_objects.{$ship}?">
              <set_value name="player.entity.$vgo_objects.{$ship}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_mode_search" exact="player.age + 8s" />
            <find_object name="$rocks" space="$ship.sector" class="class.asteroid" multiple="true" sortlimit="96" sortbydistanceto="$ship">
              <match_distance object="$ship" max="15km" />
            </find_object>
            <set_value name="$deposits" exact="[]" />
            <do_for_each name="$rock" in="$rocks" counter="$rockindex">
              <do_if value="$rock.exists">
                <find_object_component name="$deposits" object="$rock" class="class.crystal" multiple="true" append="true" />
              </do_if>
              <do_if value="$deposits.count ge 96">
                <break />
              </do_if>
            </do_for_each>
            <set_value name="$target" exact="null" />
            <do_for_each name="$deposit" in="$deposits">
              <do_if value="not $deposit.isoperational or $deposit.hull le 0 or @player.entity.$vgo_objects.{$deposit}.$vgo_mode_cooldown gt player.age or (@player.entity.$vgo_objects.{$deposit}.$vgo_owner.exists and player.entity.$vgo_objects.{$deposit}.$vgo_owner != $ship and @player.entity.$vgo_objects.{$deposit}.$vgo_expires gt player.age)">
                <continue />
              </do_if>
              <do_for_each name="$turret" in="$selected">
                <do_if value="$turret.isoperational and $turret.distanceto.{$deposit} le $turret.maxfirerange * 0.9">
                  <set_value name="$target" exact="$deposit" />
                  <break />
                </do_if>
              </do_for_each>
              <do_if value="$target.exists">
                <break />
              </do_if>
            </do_for_each>
            <do_if value="not player.entity.$vgo_objects.{$ship}?">
              <set_value name="player.entity.$vgo_objects.{$ship}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_mode_target" exact="$target" />
            <do_if value="not $target.exists">
              <continue />
            </do_if>
            <do_if value="not player.entity.$vgo_objects.{$ship}?">
              <set_value name="player.entity.$vgo_objects.{$ship}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_mode_target_until" exact="player.age + 30s" />
            <do_if value="not player.entity.$vgo_objects.{$target}?">
              <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$target}.$vgo_mode_cooldown" exact="player.age + 60s" />
            <do_if value="not player.entity.$vgo_objects.{$target}?">
              <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$target}.$vgo_owner" exact="$ship" />
            <do_if value="not player.entity.$vgo_objects.{$target}?">
              <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$target}.$vgo_expires" exact="player.age + 35s" />
          </do_if>
          <find_ship name="$traffic" space="$ship.sector" multiple="true" excluded="$ship">
            <match_distance object="$target" max="1500m" />
          </find_ship>
          <set_value name="$unsafe" exact="false" />
          <do_for_each name="$other" in="$traffic">
            <do_if value="not $other.ishostileto.{$ship}">
              <set_value name="$unsafe" exact="true" />
              <break />
            </do_if>
          </do_for_each>
          <find_station name="$station" space="$ship.sector">
            <match_distance object="$target" max="5km" />
          </find_station>
          <do_if value="$unsafe or $station.exists">
            <do_for_each name="$turret" in="$selected">
              <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed">
                <reset_turret turret="$turret" />
                <do_if value="not player.entity.$vgo_objects.{$turret}?">
                  <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                </do_if>
                <remove_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed" />
              </do_if>
            </do_for_each>
            <continue />
          </do_if>
          <do_for_each name="$turret" in="$selected">
            <do_if value="$target.isoperational and $turret.isoperational and $turret.distanceto.{$target} le $turret.maxfirerange * 0.9">
              <check_line_of_sight name="$los" object="$turret" target="$target" useaimtarget="true" />
              <do_if value="$los">
                <aim_turret turret="$turret" target="$target" />
                <do_if value="not player.entity.$vgo_objects.{$turret}?">
                  <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                </do_if>
                <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_aimed" exact="true" />
                <do_if value="$turret.isreadytofire and @player.entity.$vgo_objects.{$turret}.$vgo_mode_lasttarget == $target and @player.entity.$vgo_objects.{$turret}.$vgo_mode_aimtime le player.age - 500ms">
                  <fire_turret turret="$turret" />
                </do_if>
                <do_if value="@player.entity.$vgo_objects.{$turret}.$vgo_mode_lasttarget != $target">
                  <do_if value="not player.entity.$vgo_objects.{$turret}?">
                    <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                  </do_if>
                  <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_aimtime" exact="player.age" />
                </do_if>
                <do_if value="not player.entity.$vgo_objects.{$turret}?">
                  <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
                </do_if>
                <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_mode_lasttarget" exact="$target" />
              </do_if>
            </do_if>
          </do_for_each>
        </do_for_each>
      </actions>
    </cue>
  </cues>
</mdscript>