<?xml version='1.0' encoding='utf-8'?>
<mdscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="VGO_Survey" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Init">
      <actions>
        <set_value name="$Offers" exact="[]" />
        <set_value name="$Pending" exact="[]" />
        <set_value name="$Cursor" exact="1" />
      </actions>
    </cue>
    <cue name="NativeOffer" instantiate="true">
      <conditions>
        <event_object_signalled object="player.entity" param="'vardath.go.survey.offer'" />
      </conditions>
      <actions>
        <do_if value="event.param2.exists and event.param3.isclass.signalleak and event.param3.type == signalleaktype.voice">
          <append_to_list name="Init.$Offers" exact="[event.param2,event.param3]" />
          <do_while value="Init.$Offers.count gt 256">
            <remove_value name="Init.$Offers.{1}" />
          </do_while>
        </do_if>
      </actions>
    </cue>
    <library name="ExposeOffers">
      <actions>
        <set_value name="$offers" exact="0" />
        <do_for_each name="$row" in="Init.$Offers" counter="$oi" reverse="true">
          <do_if value="not $row.{1}.exists or not $row.{2}.exists">
            <remove_value name="Init.$Offers.{$oi}" />
            <continue />
          </do_if>
          <do_if value="$row.{2}.container == $station and $row.{1}.hasmissionoffer and not $row.{2}.islocked">
            <set_known object="$row.{2}" known="true" />
            <update_offer cue="$row.{1}" hidden="false" space="player.galaxy" />
            <set_value name="$offers" exact="$offers + 1" />
          </do_if>
        </do_for_each>
        <set_value name="$sectoroffers" exact="0" />
        <do_if value="md.GenericMissions.Manager.$MissionCues?">
          <do_for_each name="$offer" in="md.GenericMissions.Manager.$MissionCues">
            <do_if value="$offer.exists and ($offer.hasmissionoffer or $offer.hasmission) and @$offer.$OfferObject.sector == $station.sector">
              <set_value name="$sectoroffers" exact="$sectoroffers + 1" />
            </do_if>
            <do_if value="$offer.exists and $offer.hasmissionoffer and (@$offer.$OfferObject == $station or @$offer.$OfferObject.hascontext.{$station})">
              <update_offer cue="$offer" hidden="false" space="player.galaxy" />
              <set_value name="$offers" exact="$offers + 1" />
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </library>
    <library name="FindMarketV47">
      <actions>
        <!-- Assigned NPCs remain available while their visible control-room body is absent. -->
        <set_value name="$market" exact="$station.assignedcontrolentity.{controlpost.shadyguy}" />
        <do_if value="not $market.isclass.npc or not $market.isshadyguy">
          <set_value name="$market" exact="$station.controlentity.{controlpost.shadyguy}" />
        </do_if>
        <do_if value="(not $market.isclass.npc or not $market.isshadyguy) and md.$ShadyGuyMap?">
          <do_for_each name="$candidatecontact" valuename="$contactstation" in="md.$ShadyGuyMap">
            <do_if value="$contactstation == $station and $candidatecontact.isclass.npc and $candidatecontact.isshadyguy">
              <set_value name="$market" exact="$candidatecontact" /><break />
            </do_if>
          </do_for_each>
        </do_if>
      </actions>
    </library>
    <library name="Benefits">
      <actions>
        <set_value name="$generated" exact="false" />
        <include_actions ref="FindMarketV47" />
        <do_if value="$market.isclass.npc and $market.isshadyguy">
          <write_to_logbook category="general" title="'Galactic Occupations: black market contact located'" text="$ship.knownname + ': found ' + $market.knownname + ' at ' + $station.knownname + ' in ' + $station.sector.knownname + '. Existing unlocked markets retain access; locked markets require their real unlock job.'" interaction="showonmap" object="$station" />
          <do_if value="not $market.tradesvisible and not (@player.entity.$vgo_objects.{$station}.$vgo_market_offer.hasmissionoffer or @player.entity.$vgo_objects.{$station}.$vgo_market_offer.hasmission)">
            <signal_cue_instantly cue="MarketOffer" param="$station" />
          </do_if>
          <debug_text text="'GO survey market: station=%1 contact=%2 unlocked=%3; real native delivery offer requested if locked'.[$station.debugname,$market,$market.tradesvisible]" />
        </do_if>
        <do_if value="not (@player.entity.$vgo_objects.{$station}.$vgo_network_next gt player.age)">
          <set_value name="player.entity.$vgo_objects.{$station}.$vgo_network_next" exact="player.age + 24h" />
          <add_player_discount object="$station" id="'vardath.go.survey'" name="readtext.{191180}.{73}" amount="4" time="24h" />
          <do_all exact="1" chance="20">
            <add_trade_subscription object="$station" />
          </do_all>
          <set_value name="$missionrequest" exact="@md.GenericMissions.SelectMission" />
          <do_if value="$missionrequest.exists and not @md.GenericMissions.Manager.$Disabled and not @md.$TutorialActive and md.GenericMissions.Manager.$DefaultExcludedOfferFactions? and not md.GenericMissions.Manager.$DefaultExcludedOfferFactions.indexof.{$station.owner} and not md.GenericMissions.Manager.$ExcludedOfferObjects.indexof.{$station} and $sectoroffers lt md.GenericMissions.Manager.$SectorLimit and $station.hasrelation.dock.{faction.player}">
            <signal_cue_instantly cue="$missionrequest" param="table[$Sector = $station.sector, $OfferObject = $station]" />
            <set_value name="$generated" exact="true" />
          </do_if>
        </do_if>
      </actions>
    </library>
    <cue name="Decode" instantiate="true" namespace="this">
      <conditions>
        <event_object_signalled object="player.entity" param="'vardath.go.survey.leak'" />
      </conditions>
      <actions>
        <set_value name="$ship" exact="event.param2" />
        <set_value name="$work" exact="@player.entity.$vgo_objects.{$ship}.$vgo_leak_work" />
        <set_value name="$station" exact="@$work.$station" />
        <set_value name="$leak" exact="@$work.$leak" />
        <set_value name="$slots" exact="[]" />
        <do_if value="@$work.$virtual and $station.isoperational">
          <find_signalleak_location name="$slots" container="$station" multiple="true" />
        </do_if>
        <do_if value="$ship.isplayerowned and $ship != player.occupiedship and @$ship.order.id == 'VGO_scanner' and $ship.order == @player.entity.$vgo_objects.{$ship}.$vgo_order and $station.isoperational and not $station.isplayerowned and not $station.ishostileto.{$ship} and $ship.sector == $station.sector and $leak.exists and not @$work.$accepted and $work.$finished ge $work.$started + 15s and player.age le $work.$finished + 5s and $ship.distanceto.{$leak} le (if $work.$virtual then 6km else 1km) + ($ship.size + $leak.size) / 2 and (($work.$virtual and $slots.count gt 0 and $leak == $station and ($station.sector != player.sector or $station.attention lt attention.visible) and not (@player.entity.$vgo_objects.{$station}.$vgo_network_next gt player.age)) or (not $work.$virtual and $leak.isclass.signalleak and $leak.container == $station and not $leak.islocked and ($leak.type == signalleaktype.data or $leak.type == signalleaktype.voice) and not @player.entity.$vgo_objects.{$leak}.$vgo_leak_scanned))">
          <do_if value="not player.entity.$vgo_objects.{$station}?">
            <set_value name="player.entity.$vgo_objects.{$station}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$ship}.$vgo_leak_work.$accepted" exact="true" />
          <do_if value="not $work.$virtual">
            <do_if value="not player.entity.$vgo_objects.{$leak}?">
              <set_value name="player.entity.$vgo_objects.{$leak}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$leak}.$vgo_leak_scanned" exact="true" />
          </do_if>
          <set_known object="$station" known="true" updatesnapshot="true" />
          <include_actions ref="ExposeOffers" />
          <include_actions ref="Benefits" />
          <do_if value="not $work.$virtual and $leak.type == signalleaktype.data">
            <destroy_object object="$leak" explosion="false" />
          </do_if>
          <write_to_logbook category="general" title="'Galactic Occupations: signal-leak survey'" text="$ship.knownname + ': ' + (if $work.$virtual then 'simulated survey of native station signal slots at ' else 'decoded an existing public data/voice leak at ') + $station.knownname + '. Existing native offers exposed: ' + $offers + '; native job generation requested: ' + $generated + '. Station coupon/subscription cooldown: twenty-four game hours. Job acceptance, completion and black-market access remain native.'" interaction="showonmap" object="$station" />
          <debug_text text="'GO signal survey accepted v47: ship=%1 station=%2 virtual=%3 offers_exposed=%4 native_request=%5 market=%6; accepted work is not a claim that a mission was generated'.[$ship.debugname,$station.debugname,$work.$virtual,$offers,$generated,$market]" />
        </do_if>
      </actions>
      <cues>
        <cue name="PublishGeneratedOffers">
          <delay exact="6s" />
          <actions>
            <do_if value="$station.isoperational and @$work.$accepted">
              <include_actions ref="ExposeOffers" />
              <include_actions ref="FindMarketV47" />
              <set_value name="$marketoffer" exact="@player.entity.$vgo_objects.{$station}.$vgo_market_offer" />
              <set_value name="$marketavailable" exact="$marketoffer.exists and $marketoffer.hasmissionoffer" />
              <debug_text text="'GO signal survey result v47: station=%1 native_offers_visible=%2 native_request_sent=%3 market_contact=%4 market_delivery_offer=%5 market_unlocked=%6'.[$station.debugname,$offers,$generated,$market,$marketavailable,@$market.tradesvisible]" />
              <write_to_logbook category="general" title="'Galactic Occupations: signal survey results'" text="$station.knownname + ' in ' + $station.sector.knownname + ': native station offers visible: ' + $offers + '; black-market delivery offer available: ' + $marketavailable + '; existing market contact: ' + (if $market.isclass.npc and $market.isshadyguy then $market.knownname else 'none at this station') + '. A generation request does not guarantee an eligible offer. A locked black market requires its real item-delivery job; scanning does not fabricate traders or complete missions.'" interaction="showonmap" object="$station" />
            </do_if>
          </actions>
        </cue>
      </cues>
    </cue>
    <cue name="DiscountConfirmed" instantiate="true">
      <conditions>
        <event_player_discount_added />
        <check_value value="event.param == readtext.{191180}.{73}" />
      </conditions>
      <actions>
        <write_to_logbook category="general" title="'Galactic Occupations: station survey discount confirmed'" text="event.object.knownname + ': native station trade discount added. Amount is a share of each ware price range, not a flat percentage of its full price.'" interaction="showonmap" object="event.object" />
        <debug_text text="'GO survey discount confirmed v47: station=%1 amount=%2 expires=%3'.[event.object,event.param2,event.param3]" />
      </actions>
    </cue>
    <cue name="MarketOffer" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled />
      </conditions>
      <actions>
        <set_value name="$station" exact="event.param" />
        <include_actions ref="FindMarketV47" />
        <set_value name="$contact" exact="$market" />
        <set_value name="$valid" exact="$station.isoperational and not $station.isplayerowned and $station.hasrelation.dock.{faction.player} and $contact.isclass.npc and $contact.isshadyguy and not $contact.tradesvisible and not (@player.entity.$vgo_objects.{$station}.$vgo_market_offer.hasmissionoffer or @player.entity.$vgo_objects.{$station}.$vgo_market_offer.hasmission)" />
        <do_if value="$valid">
          <set_value name="player.entity.$vgo_objects.{$station}.$vgo_market_offer" exact="this" />
          <set_value name="$item" exact="[ware.inv_decryptionmodule,ware.inv_securitydecryptionsystem,ware.inv_unstablecrystal,ware.inv_agidevice_02].random" />
          <set_value name="$amount" min="1" max="3" />
        </do_if>
      </actions>
      <cues>
        <cue name="OfferValid" onfail="cancel" checkinterval="1s">
          <conditions>
            <check_value value="$valid" />
          </conditions>
          <cues>
            <cue name="NativeMarketWork" ref="md.GM_BringItems.Start">
              <param name="MissionCue" value="MarketOffer" />
              <param name="OfferObject" value="$station" />
              <param name="Client" value="$contact" />
              <param name="ClientOwner" value="$contact.owner" />
              <param name="MissionLevel" value="1" />
              <param name="Difficulty" value="level.easy" />
              <param name="Page" value="30135" />
              <param name="TextOffset" value="1000" />
              <param name="RewardObj" value="$contact" />
              <param name="RewardText" value="readtext.{30135}.{106}" />
              <param name="DeliveryNPC" value="$contact" />
              <param name="DeliveryStation" value="$station" />
              <param name="DeliveryItem" value="$item" />
              <param name="DeliveryAmount" value="$amount" />
              <param name="MissionDuration" value="1h" />
              <param name="DurationUntilBonusDecay" value="30min" />
              <param name="DurationUntilBonusExpiry" value="51min" />
              <param name="BBSSpace" value="player.galaxy" />
              <param name="RemoveOnSectorChange" value="false" />
              <param name="OfferDistance" value="null" />
              <param name="OfferMaxDistance" value="null" />
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>
    <cue name="PublicationBootstrapV42">
      <actions>
        <do_if value="not Init.$Pending?">
          <set_value name="Init.$Pending" exact="[]" />
        </do_if>
        <do_if value="not Init.$Cursor?">
          <set_value name="Init.$Cursor" exact="1" />
        </do_if>
      </actions>
    </cue>
    <cue name="QueuePublication" instantiate="true" namespace="this">
      <conditions>
        <event_object_signalled object="player.entity" param="'vardath.go.survey.publish'" />
      </conditions>
      <actions>
        <set_value name="$module" exact="event.param2" />
        <set_value name="$ship" exact="event.param3" />
        <set_value name="$sample" exact="@player.entity.$vgo_objects.{$module}.$vgo_survey_sample" />
        <set_value name="$station" exact="@$sample.$station" />
        <do_if value="$module.isoperational and $ship.isplayerowned and $ship != player.occupiedship and @$ship.order.id == 'VGO_scanner' and $ship.order == @player.entity.$vgo_objects.{$ship}.$vgo_order and $sample.$ship == $ship and $station.isoperational and not $station.ishostileto.{$ship} and $ship.sector == $station.sector and $ship.distanceto.{$module} le 3km + ($ship.size + $module.size) / 2 and $sample.$finished ge $sample.$started + 10s and player.age le $sample.$finished + 5s and $sample.$level gt 0 and $sample.$level == $ship.maxscanlevel">
          <!-- Publish each actual ten-second close-range survey to the native
               station snapshot immediately; NPC recordings must not remain '?'.
               Station and module discovery are not blueprint unlocks. -->
          <set_known object="$module" known="true" updatesnapshot="true"/>
          <set_known object="$station" known="true" updatesnapshot="true"/>
          <set_object_scanned object="$module"/>
          <!-- Optional EMP-assisted blueprint recovery uses one real EMP from
               the player's inventory, the same eligibility/research checks
               as native md.Signal_Leaks, and no unresearched/special blueprints.
               This is a remote resource-consuming survey, NOT a physical
               spacesuit bomb animation or manufactured data leaks. -->
          <do_if value="$module.isclass.module and @player.entity.$vgo_objects.{$ship}.$vgo_emp_enabled and not $station.isplayerowned and $module.macro.ware and not player.blueprints.{$module.macro.ware}.any.exists and not $module.macro.ware.hastag.noplayerblueprint and player.entity.inventory.{ware.bomb_player_limpet_emp_01_mk1}.count ge 1">
            <set_value name="$blueprintware" exact="$module.macro.ware"/>
            <set_value name="$researchready" exact="true"/>
            <set_value name="$precursors" exact="$blueprintware.research.requiredprecursors.list"/>
            <do_for_each name="$precursor" in="$precursors">
              <do_if value="not $precursor.research.unlocked">
                <set_value name="$researchready" exact="false"/>
                <break/>
              </do_if>
            </do_for_each>
            <do_if value="$researchready and not player.blueprints.{$blueprintware}.any.exists and player.entity.inventory.{ware.bomb_player_limpet_emp_01_mk1}.count ge 1">
              <remove_inventory entity="player.entity" ware="ware.bomb_player_limpet_emp_01_mk1" exact="1"/>
              <add_blueprints macros="$module.macro"/>
              <write_to_logbook category="general" title="'Galactic Occupations: EMP blueprint survey'" text="'%1 remotely surveyed %2 on %3 using one Spacesuit EMP from player inventory; eligible researched module blueprint unlocked: %4.'.[$ship.knownname,$module.knownname,$station.knownname,$blueprintware.name]" interaction="showonmap" object="$station"/>
            </do_if>
          </do_if>
          <do_if value="@player.entity.$vgo_objects.{$module}.$vgo_survey_queued or Init.$Pending.count lt 2048">
            <do_if value="not @player.entity.$vgo_objects.{$module}.$vgo_survey_queued">
              <append_to_list name="Init.$Pending" exact="$module" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_queued" exact="true" />
            <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_sample_level" exact="if player.entity.$vgo_objects.{$module}.$vgo_survey_sample_level? then [$sample.$level,player.entity.$vgo_objects.{$module}.$vgo_survey_sample_level].max else $sample.$level" />
            <debug_text text="'GO component survey queued: module=%1 ship=%2 target_level=%3 player_cap=%4; real sample retained, native scan publication pending'.[$module,$ship,$sample.$level,player.maxscanlevel]" />
          </do_if>
        </do_if>
      </actions>
    </cue>
    <library name="PublishPending">
      <actions>
        <set_value name="$published" exact="0" />
        <do_all exact="[Init.$Pending.count,16].min">
          <do_if value="not Init.$Pending.count">
            <break />
          </do_if>
          <do_if value="Init.$Cursor lt 1 or Init.$Cursor gt Init.$Pending.count">
            <set_value name="Init.$Cursor" exact="1" />
          </do_if>
          <set_value name="$index" exact="Init.$Cursor" />
          <set_value name="$module" exact="Init.$Pending.{$index}" />
          <do_if value="not $module.isoperational">
            <remove_value name="Init.$Pending.{$index}" />
            <continue />
          </do_if>
          <set_value name="$goal" exact="@player.entity.$vgo_objects.{$module}.$vgo_survey_sample_level" />
          <do_if value="$module.scannedlevel lt $goal and player.maxscanlevel gt $module.scannedlevel and (not player.entity.$vgo_objects.{$module}.$vgo_survey_publication_retry? or player.age ge @player.entity.$vgo_objects.{$module}.$vgo_survey_publication_retry or @player.entity.$vgo_objects.{$module}.$vgo_survey_publication_cap != player.maxscanlevel)">
            <set_value name="$beforelevel" exact="$module.scannedlevel" />
            <set_object_scanned object="$module" />
            <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_publication_cap" exact="player.maxscanlevel" />
            <do_if value="$module.scannedlevel le $beforelevel">
              <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_publication_retry" exact="player.age + 10min" />
            </do_if>
          </do_if>
          <do_if value="$module.scannedlevel ge $goal">
            <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_level" exact="$module.scannedlevel" />
            <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_time" exact="player.age" />
            <remove_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_queued" />
            <set_known object="$module" known="true" updatesnapshot="true" />
            <set_known object="$module.container" known="true" updatesnapshot="true" />
            <remove_value name="Init.$Pending.{$index}" />
            <set_value name="$published" exact="$published + 1" />
          </do_if>
          <do_else>
            <set_value name="Init.$Cursor" exact="$index + 1" />
          </do_else>
        </do_all>
        <do_if value="$published gt 0">
          <write_to_logbook category="general" title="'Galactic Occupations: native scan information published'" text="'' + $published + ' previously sampled components published at the native scanner cap. Remaining queued components: ' + Init.$Pending.count" />
        </do_if>
      </actions>
    </library>
    <cue name="PublishPendingSurveys" instantiate="true" namespace="this" checkinterval="30s">
      <conditions>
        <check_value value="Init.$Pending? and Init.$Pending.count gt 0 and player.maxscanlevel gt 0" />
      </conditions>
      <actions>
        <include_actions ref="PublishPending" />
      </actions>
    </cue>
  </cues>
</mdscript>
