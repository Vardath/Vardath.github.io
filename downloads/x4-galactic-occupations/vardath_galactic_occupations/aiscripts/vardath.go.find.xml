<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.find" version="1" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="job"/>
  </params>
  <attention min="unknown">
    <actions>
      <set_value name="$candidates" exact="[]"/>
      <do_if value="$job == 2 and @this.ship.$vgo_taxi_dest.exists and @this.ship.people.{this.ship.$vgo_passenger}.exists">
        <return value="this.ship.$vgo_taxi_dest"/>
      </do_if>
      <do_if value="$job == 1 or $job == 12">
        <find_ship name="$candidates" space="this.ship.sector" primarypurpose="purpose.trade" multiple="true" sortbydistanceto="this.ship" sortlimit="40"/>
      </do_if>
      <do_elseif value="$job == 2 or $job == 3">
        <find_station name="$candidates" space="this.ship.sector" multiple="true" sortbydistanceto="this.ship" sortlimit="40"/>
      </do_elseif>
      <do_elseif value="$job == 4">
        <find_object name="$candidates" space="this.ship.sector" class="[class.anomaly, class.gate, class.highwayentrygate]" multiple="true" sortbydistanceto="this.ship" sortlimit="40"/>
      </do_elseif>
      <do_elseif value="$job == 5">
        <find_object name="$candidates" space="this.ship.sector" multiple="true" landmark="true"/>
        <find_object name="$candidates" space="this.ship.sector" multiple="true" datavault="true" append="true"/>
        <find_object name="$candidates" space="this.ship.sector" class="[class.anomaly]" multiple="true" append="true"/>
        <find_station name="$candidates" space="this.ship.sector" factionheadquarters="true" multiple="true" append="true"/>
        <find_ship name="$candidates" space="this.ship.sector" owner="faction.ownerless" multiple="true" append="true"/>
        <do_if value="@md.VGO_Catalogue.Init.$Macros.count">
          <find_object name="$candidates" space="this.ship.sector" macro="md.VGO_Catalogue.Init.$Macros" multiple="true" append="true"/>
        </do_if>
      </do_elseif>
      <do_elseif value="$job == 6">
        <!-- The native tutorial uses exactly this asteroid -> class.crystal traversal. -->
        <find_object name="$rocks" space="this.ship.sector" class="class.asteroid" multiple="true" sortbydistanceto="this.ship" sortlimit="96">
          <match_distance object="this.ship" max="40km"/>
        </find_object>
        <find_object_component name="$candidates" object="$rocks" class="class.crystal" multiple="true" sortlimit="48" sortbyvalue="if loop.element.drop == 'drops_crystal_s_05' then 125000 else (if loop.element.drop == 'drops_crystal_s_04' then 20000 else (if loop.element.drop == 'drops_crystal_s_03' then 15000 else (if loop.element.drop == 'drops_crystal_s_02' then 10000 else 1000)))" sortdescending="true"/>
      </do_elseif>
      <do_elseif value="$job == 8">
        <find_object name="$candidates" space="this.ship.sector" class="class.asteroid" indestructible="false" invulnerable="false" multiple="true" sortbydistanceto="this.ship" sortlimit="48">
          <match_distance object="this.ship" max="40km"/>
        </find_object>
      </do_elseif>
      <do_elseif value="$job == 7 or $job == 11">
        <find_ship name="$candidates" space="this.ship.sector" ishostileto="this.ship" multiple="true" sortbydistanceto="this.ship" sortlimit="32"/>
      </do_elseif>
      <do_elseif value="$job == 9 or $job == 10">
        <find_ship name="$candidates" space="this.ship.sector" multiple="true" sortbydistanceto="this.ship" sortlimit="48"/>
      </do_elseif>
      <!-- Random selection without replacement avoids starving less-near targets. -->
      <do_while value="$candidates.count">
        <set_value name="$candidate" exact="if $job == 6 then $candidates.{1} else $candidates.random"/>
        <remove_value name="$candidates.{$candidates.indexof.{$candidate}}"/>
        <do_if value="not $candidate.exists or $candidate == this.ship">
          <continue/>
        </do_if>
        <do_if value="@$candidate.$vgo_owner.exists and @$candidate.$vgo_owner != this.ship and @$candidate.$vgo_expires gt player.age">
          <continue/>
        </do_if>
        <do_if value="@$candidate.$vgo_cooldowns.{$job} gt player.age">
          <continue/>
        </do_if>
        <do_if value="$job != 7 and $job != 11 and $candidate.ishostileto.{this.ship}">
          <continue/>
        </do_if>
        <do_if value="($job == 1 or $job == 2 or $job == 9 or $job == 10 or $job == 12) and @this.ship.$vgo_preferred and $candidate.owner != this.ship.$vgo_preferred">
          <continue/>
        </do_if>
        <do_if value="$job == 1 or $job == 12">
          <run_script name="'vardath.go.destination'" result="$dest">
            <param name="ship" value="$candidate"/>
          </run_script>
          <do_if value="not $dest.exists">
            <continue/>
          </do_if>
        </do_if>
        <do_if value="$job == 2 and (not $candidate.dockingallowed.{this.ship} or not $candidate.dock.{this.ship.docksize}.exists or not this.ship.people.free)">
          <continue/>
        </do_if>
        <do_if value="$job == 3 and $candidate.revealedpercentage ge 100">
          <continue/>
        </do_if>
        <do_if value="$job == 4 and @$candidate.$vgo_mapped">
          <continue/>
        </do_if>
        <do_if value="$job == 5 and @this.ship.$vgo_tour.indexof.{$candidate}">
          <continue/>
        </do_if>
        <do_if value="$job == 8 and @this.ship.$vgo_resourceonly and not $candidate.wares.count">
          <continue/>
        </do_if>
        <do_if value="$job == 9 and (not $candidate.pilot.exists or not $candidate.pilot.iscommable or not $candidate.owner.hasrelation.dock.{faction.player})">
          <continue/>
        </do_if>
        <do_if value="$job == 10 and ($candidate.primarypurpose != purpose.trade or $candidate.isplayerowned or not this.ship.sector.policefaction.hasrelation.dock.{faction.player})">
          <continue/>
        </do_if>
        <do_if value="$job == 11 and (not $candidate.iscapturable or $candidate.ismission or $candidate.isinvulnerable or $candidate.hullpercentage ge 25 or not $candidate.pilot.iscommable or $candidate.isplayerowned)">
          <continue/>
        </do_if>
        <do_if value="$job == 7 and ($candidate.iscapitalship or ($candidate.dps.all gt this.ship.dps.all * (1 + this.ship.$vgo_risk)))">
          <continue/>
        </do_if>
        <return value="$candidate"/>
      </do_while>
      <return value="null"/>
    </actions>
  </attention>
</aiscript>
