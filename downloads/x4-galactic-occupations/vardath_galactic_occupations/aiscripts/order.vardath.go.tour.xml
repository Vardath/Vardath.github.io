<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="order.vardath.go.tour" version="4" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <order id="VGO_tour" name="{191180,105}" description="{191180,205}" category="navigation" infinite="true" allowinloop="false">
    <params>
      <param name="home" type="sector" default="this.ship.sector" text="{191180,2}" />
      <param name="range" type="number" default="99" text="{191180,3}">
        <input_param name="min" value="0" />
        <input_param name="max" value="99" />
        <input_param name="step" value="1" />
      </param>
      <param name="risk" type="number" default="1" text="{191180,4}">
        <input_param name="min" value="0" />
        <input_param name="max" value="2" />
        <input_param name="step" value="1" />
      </param>
      <param name="repeat" type="bool" default="true" text="{191180,6}" />
      <param name="debugchance" type="bool" default="0" text="{191180,8}" advanced="true">
        <input_param name="truevalue" value="100" />
      </param>
      <param name="viewtime" type="time" default="45s" text="{191180,16}" advanced="true">
        <input_param name="min" value="10s" />
        <input_param name="max" value="5min" />
        <input_param name="step" value="5s" />
      </param>
      <param name="stops" type="number" default="10" text="{191180,31}">
        <input_param name="min" value="10" />
        <input_param name="max" value="20" />
        <input_param name="step" value="1" />
        <patch sinceversion="2" value="10" />
      </param>
      <param name="ticketfee" type="money" default="500000Cr" text="{191180,32}" advanced="true">
        <input_param name="min" value="50000Cr" />
        <input_param name="max" value="2000000Cr" />
        <input_param name="step" value="50000Cr" />
        <patch sinceversion="2" value="500000Cr" />
      </param>
    </params>
    <requires>
      <match owner="faction.player" />
      <match class="class.spacesuit" negate="true" />
      <match shiptype="shiptype.lasertower" negate="true" />
      <match unit="false" />
      <match class="[class.ship_s, class.ship_m]" />
    </requires>
    <location object="if @player.entity.$vgo_objects.{this.ship}.$vgo_destination.exists then player.entity.$vgo_objects.{this.ship}.$vgo_destination else (if @player.entity.$vgo_objects.{this.ship}.$vgo_target.exists then player.entity.$vgo_objects.{this.ship}.$vgo_target else this.ship)" />
  </order>
  <interrupts>
    <handler ref="AttackHandler" />
    <handler ref="MissileLockHandler" />
    <handler ref="ScannedHandler" />
    <handler ref="InspectedHandler" />
    <handler ref="TideHandler" />
  </interrupts>
  <patch sinceversion="4">
    <do_if value="this.ship.isplayerowned and this.ship.order == this.ship.defaultorder and this.ship.order.id == 'VGO_tour' and this.ship.order.isparameditable.home">
      <edit_order_param order="this.ship.order" param="'home'" value="$home" />
    </do_if>
  </patch>
  <attention min="unknown">
    <actions>
      <label name="work" />
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_stops" exact="$stops" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_ticketfee" exact="$ticketfee" />
      <set_order_syncpoint_reached order="this.ship.order" />
      <run_script name="'vardath.go.worker'">
        <param name="job" value="5" />
        <param name="home" value="$home" />
        <param name="range" value="$range" />
        <param name="risk" value="$risk" />
        <param name="repeat" value="$repeat" />
        <param name="debugchance" value="$debugchance" />
        <param name="viewtime" value="$viewtime" />
      </run_script>
      <wait exact="15s" />
      <do_if value="this.ship.isplayerowned and this.ship.order.id == 'VGO_tour'">
        <resume label="work" />
      </do_if>
    </actions>
  </attention>
</aiscript>