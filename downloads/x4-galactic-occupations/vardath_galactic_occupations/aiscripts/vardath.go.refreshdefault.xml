        <set_order_state order="this.ship.defaultorder" state="orderstate.finish" />
        <create_order id="'VGO_taxi'" object="this.ship" name="$refreshed" default="true">
          <param name="home" value="$settings.$home" />
          <param name="range" value="$settings.$range" />
          <param name="risk" value="$settings.$risk" />
          <param name="preferred" value="$settings.$preferred" />
          <param name="repeat" value="$settings.$repeat" />
          <param name="minreward" value="$settings.$minreward" />
          <param name="debugchance" value="$settings.$debugchance" />
        </create_order>
        <do_if value="$samehack">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_hack_order" exact="$refreshed" />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_order" exact="$refreshed" />
        <debug_text text="'GO critical default repaired: %1 id=%2; settings and persistent job state retained'.[this.ship.debugname,$refreshed.id]" />
        <wait exact="1s" />
        <return value="true" />
      </do_if>
      <do_if value="this.ship.defaultorder.id == 'VGO_tour'">
        <set_value name="$settings" exact="table[]" />
        <set_value name="$settings.$home" exact="if @this.ship.defaultorder.$home != null then this.ship.defaultorder.$home else this.ship.sector" />
        <set_value name="$settings.$range" exact="if @this.ship.defaultorder.$range != null then this.ship.defaultorder.$range else 99" />
        <set_value name="$settings.$risk" exact="if @this.ship.defaultorder.$risk != null then this.ship.defaultorder.$risk else 1" />
        <set_value name="$settings.$repeat" exact="if @this.ship.defaultorder.$repeat != null then this.ship.defaultorder.$repeat else true" />
        <set_value name="$settings.$debugchance" exact="if @this.ship.defaultorder.$debugchance != null then this.ship.defaultorder.$debugchance else 0" />
        <set_value name="$settings.$viewtime" exact="if @this.ship.defaultorder.$viewtime != null then this.ship.defaultorder.$viewtime else 45s" />
        <set_value name="$settings.$stops" exact="if @this.ship.defaultorder.$stops != null then this.ship.defaultorder.$stops else 10" />
        <set_value name="$settings.$ticketfee" exact="if @this.ship.defaultorder.$ticketfee != null then this.ship.defaultorder.$ticketfee else 500000Cr" />
        <set_value name="$samehack" exact="@player.entity.$vgo_objects.{this.ship}.$vgo_hack_order == this.ship.defaultorder" />
        <set_order_state order="this.ship.defaultorder" state="orderstate.finish" />
        <create_order id="'VGO_tour'" object="this.ship" name="$refreshed" default="true">
          <param name="home" value="$settings.$home" />
          <param name="range" value="$settings.$range" />
          <param name="risk" value="$settings.$risk" />
          <param name="repeat" value="$settings.$repeat" />
          <param name="debugchance" value="$settings.$debugchance" />
          <param name="viewtime" value="$settings.$viewtime" />
          <param name="stops" value="$settings.$stops" />
          <param name="ticketfee" value="$settings.$ticketfee" />
        </create_order>
        <do_if value="$samehack">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_hack_order" exact="$refreshed" />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_order" exact="$refreshed" />
        <debug_text text="'GO critical default repaired: %1 id=%2; settings and persistent job state retained'.[this.ship.debugname,$refreshed.id]" />
        <wait exact="1s" />
        <return value="true" />
      </do_if>
      <return value="false" />
    </actions>
  </attention>
