<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.crystal.settle" version="3" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="buyer"/>
  </params>
  <attention min="unknown">
    <actions>
      <run_script name="'vardath.go.crystal.atcounter'" result="$atcounter">
        <param name="buyer" value="$buyer"/>
      </run_script>
      <do_if value="not $atcounter">
        <return value="false"/>
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Crew crystal sale at the inventory counter on ' + $buyer.knownname"/>
      <wait exact="10s"/>
      <run_script name="'vardath.go.crystal.atcounter'" result="$atcounter">
        <param name="buyer" value="$buyer"/>
      </run_script>
      <do_if value="not $atcounter">
        <return value="false"/>
      </do_if>
      <run_script name="'vardath.go.crystal.exchange'" result="$sold" sinceversion="2">
        <param name="buyer" value="$buyer"/>
        <param name="physical" value="true"/>
      </run_script>
      <return value="@$sold"/>
    </actions>
  </attention>
</aiscript>
