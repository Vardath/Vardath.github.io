<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.worker" version="1" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="job" default="1"/>
    <param name="home" default="this.ship.sector"/>
    <param name="range" default="99"/>
    <param name="risk" default="1"/>
    <param name="preferred" default="null"/>
    <param name="repeat" default="true"/>
    <param name="minreward" default="0Cr"/>
    <param name="debugchance" default="0"/>
    <param name="basechance" default="8"/>
    <param name="cooldown" default="6h"/>
    <param name="sell" default="true"/>
    <param name="sellthreshold" default="100"/>
    <param name="beamonly" default="true"/>
    <param name="transit" default="false"/>
    <param name="collect" default="false"/>
    <param name="resourceonly" default="false"/>
    <param name="viewtime" default="45s"/>
    <param name="collectionlimit" default="500"/>
  </params>
  <interrupts>
    <handler>
      <conditions>
        <event_object_signalled object="this.ship" param="'vardath.go.timeout'"/>
      </conditions>
      <actions>
        <set_value name="this.ship.$vgo_status" exact="'Recovering from a timed-out assignment'"/>
        <abort_called_scripts resume="cleanup"/>
      </actions>
    </handler>
  </interrupts>
  <attention min="unknown">
    <actions>
      <set_value name="this.ship.$vgo_home" exact="$home"/><set_value name="this.ship.$vgo_range" exact="$range"/><set_value name="this.ship.$vgo_collectionlimit" exact="$collectionlimit"/>
      <!-- Runs only as the active native order. No MD order injection and no queue replacement. -->
      <set_value name="this.ship.$vgo_job" exact="$job"/>
      <set_value name="this.ship.$vgo_order" exact="this.ship.order"/>
      <set_value name="this.ship.$vgo_risk" exact="$risk"/>
      <set_value name="this.ship.$vgo_minreward" exact="$minreward"/>
      <set_value name="this.ship.$vgo_preferred" exact="if $preferred.exists then $preferred.owner else null"/>
      <set_value name="this.ship.$vgo_debug" exact="$debugchance"/>
      <set_value name="this.ship.$vgo_basechance" exact="$basechance"/>
      <set_value name="this.ship.$vgo_cooldown" exact="$cooldown"/>
      <set_value name="this.ship.$vgo_sell" exact="$sell"/>
      <set_value name="this.ship.$vgo_sellthreshold" exact="$sellthreshold"/>
      <set_value name="this.ship.$vgo_beamonly" exact="$beamonly"/>
      <set_value name="this.ship.$vgo_transit" exact="$transit"/>
      <set_value name="this.ship.$vgo_collect" exact="$collect"/>
      <set_value name="this.ship.$vgo_resourceonly" exact="$resourceonly"/>
      <set_value name="this.ship.$vgo_viewtime" exact="$viewtime"/>
      <do_if value="not this.ship.$vgo_serial?">
        <set_value name="this.ship.$vgo_serial" exact="0"/>
      </do_if>
      <signal_objects object="player.entity" param="'vardath.go.register'" param2="this.ship"/>
      <set_value name="$sectors" exact="if @this.ship.$vgo_searchjob == $job and @this.ship.$vgo_searchhome == $home and @this.ship.$vgo_searchrange == $range then @this.ship.$vgo_sectors else []"/>
      <set_value name="this.ship.$vgo_searchrange" exact="$range"/>
      <set_value name="this.ship.$vgo_searchhome" exact="$home"/>
      <set_value name="this.ship.$vgo_searchjob" exact="$job"/>
      <do_if value="not $sectors?">
        <set_value name="$sectors" exact="[]"/>
      </do_if>
      <set_value name="$done" exact="false"/>
      <label name="start"/>
      <set_order_syncpoint_reached order="this.ship.order"/>
      <do_if value="not this.ship.isplayerowned">
        <return/>
      </do_if>
      <do_if value="this.ship == player.occupiedship or ($done and not $repeat)">
        <set_value name="this.ship.$vgo_status" exact="'Standing by: player control or one assignment completed'"/>
        <set_command_action commandaction="commandaction.standingby"/>
        <wait exact="10s"/>
        <resume label="start"/>
      </do_if>
      <do_if value="($job == 6 or $job == 8) and (this.ship.iscapitalship or this.ship.attention lt attention.visible)">
        <set_value name="this.ship.$vgo_status" exact="'Physical harvesting needs an S/M ship in high attention; waiting'"/>
        <set_command_action commandaction="commandaction.standingby"/>
        <wait min="25s" max="35s"/>
        <resume label="start"/>
      </do_if>
      <do_if value="not $home.exists">
        <set_value name="$home" exact="this.ship.sector"/>
      </do_if>
      <do_if value="$job == 6">
        <run_script name="'vardath.go.crystalcount'" result="$count"/>
        <do_if value="$count ge $collectionlimit">
          <do_if value="$sell">
            <run_script name="'vardath.go.sellcrystals'"/>
          </do_if>
          <set_value name="this.ship.$vgo_status" exact="'Crystal collection limit reached; sell or transfer pilot inventory'"/>
          <wait exact="30s"/>
          <resume label="start"/>
        </do_if>
      </do_if>
      <set_value name="this.ship.$vgo_status" exact="'Searching for an assignment'"/>
      <set_command_action commandaction="commandaction.calculating"/>
      <wait min="2s" max="8s"/>
      <run_script name="'vardath.go.find'" result="$target">
        <param name="job" value="$job"/>
      </run_script>
      <do_if value="not $target.exists">
        <do_if value="not $sectors.count">
          <set_value name="this.ship.$vgo_tour_cycle" exact="true"/>
          <do_if value="$job == 5 and @this.ship.$vgo_tour_cycle">
            <set_value name="this.ship.$vgo_tour" exact="[]"/>
          </do_if>
          <find_sector_in_range name="$sectors" object="$home" maxdistance="$range" multiple="true" accessgrantedto="faction.player"/>
        </do_if>
        <do_if value="$sectors.count">
          <set_value name="$next" exact="$sectors.random"/>
          <remove_value name="$sectors.{$sectors.indexof.{$next}}"/>
          <set_value name="this.ship.$vgo_sectors" exact="$sectors"/>
          <do_if value="$next.exists and ($risk == 2 or not $next.owner.hasrelation.enemy.{faction.player})">
            <set_value name="this.ship.$vgo_deadline" exact="player.age + 10min"/>
            <set_value name="this.ship.$vgo_status" exact="'Seeking work in ' + $next.knownname"/>
            <run_script name="'move.generic'">
              <param name="destination" value="$next"/>
              <param name="endintargetsector" value="true"/>
              <param name="strictblacklist" value="true"/>
              <param name="useknownpath" value="$job != 4"/>
            </run_script>
          </do_if>
        </do_if>
        <remove_value name="this.ship.$vgo_deadline"/>
        <wait min="20s" max="35s"/>
        <resume label="start"/>
      </do_if>
      <!-- The reservation write is non-blocking and occurs before starting work. -->
      <set_value name="$target.$vgo_owner" exact="this.ship"/>
      <set_value name="$target.$vgo_expires" exact="player.age + 25min"/>
      <set_value name="this.ship.$vgo_target" exact="$target"/>
      <set_value name="this.ship.$vgo_serial" exact="this.ship.$vgo_serial + 1"/>
      <remove_value name="this.ship.$vgo_destination"/><set_value name="this.ship.$vgo_verified" exact="false"/>
      <set_value name="this.ship.$vgo_reward" exact="0Cr"/>
      <set_value name="this.ship.$vgo_rewardfaction" exact="null"/>
      <set_value name="this.ship.$vgo_deadline" exact="player.age + 20min"/>
      <set_value name="$success" exact="false"/>
      <debug_text text="'GO: %s job %s target %s'.[this.ship.debugname, $job, $target.debugname]" chance="$debugchance"/>
      <do_if value="$job == 1">
        <run_script name="'vardath.go.task.escort'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_if>
      <do_elseif value="$job == 2">
        <run_script name="'vardath.go.task.taxi'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 3">
        <run_script name="'vardath.go.task.scanner'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 4">
        <run_script name="'vardath.go.task.mapper'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 5">
        <run_script name="'vardath.go.task.tour'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 6">
        <run_script name="'vardath.go.task.crystal'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 7">
        <run_script name="'vardath.go.task.lure'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 8">
        <run_script name="'vardath.go.task.demolition'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 9">
        <run_script name="'vardath.go.task.morale'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 10">
        <run_script name="'vardath.go.task.inspection'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 11">
        <run_script name="'vardath.go.task.recruit'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 12">
        <run_script name="'vardath.go.task.patrol'" result="$success">
          <param name="target" value="$target"/>
        </run_script>
      </do_elseif>
      <do_if value="$success">
        <set_value name="$done" exact="true"/>
        <run_script name="'vardath.go.reward'"/>
      </do_if>
      <label name="cleanup"/>
      <run_script name="'vardath.go.release'"/>
      <do_if value="@$target.exists and @$target.$vgo_owner == this.ship">
        <remove_value name="$target.$vgo_owner"/>
        <remove_value name="$target.$vgo_expires"/>
        <do_if value="not $target.$vgo_cooldowns?">
          <set_value name="$target.$vgo_cooldowns" exact="table[]"/>
        </do_if>
        <do_if value="not $target.$vgo_cooldowns.{$job}? or $target.$vgo_cooldowns.{$job} lt player.age + 5min">
          <set_value name="$target.$vgo_cooldowns.{$job}" exact="player.age + 5min"/>
        </do_if>
      </do_if>
      <remove_value name="this.ship.$vgo_target"/>
      <remove_value name="this.ship.$vgo_destination"/><remove_value name="this.ship.$vgo_deadline"/>
      <wait min="10s" max="20s"/>
      <resume label="start"/>
    </actions>
  </attention>
</aiscript>
