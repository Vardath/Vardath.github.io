<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.worker" version="13" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="job" default="1" />
    <param name="home" default="this.ship.sector" />
    <param name="range" default="99" />
    <param name="risk" default="1" />
    <param name="preferred" default="null" />
    <param name="repeat" default="true" />
    <param name="minreward" default="0Cr" />
    <param name="debugchance" default="0" />
    <param name="basechance" default="8" />
    <param name="cooldown" default="6h" />
    <param name="sell" default="false" />
    <param name="sellthreshold" default="100" />
    <param name="beamonly" default="false" />
    <param name="transit" default="false" />
    <param name="collect" default="false" />
    <param name="resourceonly" default="false" />
    <param name="viewtime" default="45s" />
    <param name="collectionlimit" default="500" />
    <param name="hackstation" default="null" />
    <param name="hackpanel" default="''" />
    <param name="hackonce" default="false" />
    <param name="simfallback" default="true" />
    <param name="miningtime" default="5min" />
    <param name="batchsize" default="24" />
  </params>
  <interrupts>
    <handler>
      <conditions>
        <event_object_signalled object="this.assignedcontrolled" param="'vardath.go.timeout'" />
      </conditions>
      <actions>
        <do_if value="@player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_hack_phase and @player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_hack_deployed and @player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_hack_actor.exists and not @player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_hack_actor.room.hascontext.{this.assignedcontrolled}">
          <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_deadline" exact="player.age + 30min" />
        </do_if>
        <do_else>
          <do_if value="not player.entity.$vgo_objects?">
            <set_value name="player.entity.$vgo_objects" exact="table[]" />
          </do_if>
          <do_if value="not player.entity.$vgo_objects.{this.assignedcontrolled}?">
            <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_status" exact="'Recovering from a timed-out assignment'" />
          <abort_called_scripts resume="cleanup" />
        </do_else>
      </actions>
    </handler>
    <handler>
      <conditions>
        <event_object_signalled object="this.assignedcontrolled" param="'vardath.go.restart34'" />
      </conditions>
      <actions>
        <do_if value="not @player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_hack_deployed">
          <abort_called_scripts resume="cleanup" />
        </do_if>
      </actions>
    </handler>
  </interrupts>
  <patch sinceversion="2">
    <do_if value="not player.entity.$vgo_objects?">
      <set_value name="player.entity.$vgo_objects" exact="table[]" />
    </do_if>
    <do_if value="not player.entity.$vgo_objects.{this.ship}?">
      <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
    </do_if>
    <set_value name="$sectors" exact="[]" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="false" />
    <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_scope" />
    <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_catalogue" />
  </patch>
  <patch sinceversion="4">
    <do_if value="not player.entity.$vgo_objects?">
      <set_value name="player.entity.$vgo_objects" exact="table[]" />
    </do_if>
    <do_if value="not player.entity.$vgo_objects.{this.ship}?">
      <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
    </do_if>
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_home" exact="$home" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_range" exact="$range" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_collectionlimit" exact="$collectionlimit" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_job" exact="$job" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_order" exact="this.ship.order" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_risk" exact="$risk" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_minreward" exact="$minreward" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_preferred" exact="if $preferred.exists then $preferred.owner else null" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_debug" exact="$debugchance" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_basechance" exact="$basechance" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_cooldown" exact="$cooldown" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_sell" exact="$sell" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_sellthreshold" exact="$sellthreshold" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_beamonly" exact="$beamonly" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_transit" exact="$transit" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_collect" exact="$collect" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_resourceonly" exact="$resourceonly" />
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_viewtime" exact="$viewtime" />
    <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_serial?">
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_serial" exact="0" />
    </do_if>
    <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_runtime" exact="0" />
    <set_value name="$sectors" exact="[]" />
    <set_value name="$target" exact="null" />
    <set_value name="$done" exact="false" />
  </patch>
  <patch sinceversion="10">
    <do_if value="not $simfallback? or @$simfallback == null">
      <set_value name="$simfallback" exact="true" />
    </do_if>
    <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_simfallback" exact="$simfallback" />
    <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_runtime" exact="0" />
  </patch>
  <patch sinceversion="11">
    <do_if value="not $sectors? or @$sectors == null">
      <set_value name="$sectors" exact="[]" />
    </do_if>
    <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_runtime" exact="0" />
  </patch>
  <patch sinceversion="12">
    <do_if value="not $miningtime? or @$miningtime == null">
      <set_value name="$miningtime" exact="5min" />
    </do_if>
    <do_if value="not $batchsize? or @$batchsize == null">
      <set_value name="$batchsize" exact="24" />
    </do_if>
    <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_runtime" exact="0" />
  </patch>
  <patch sinceversion="13">
    <set_value name="player.entity.$vgo_objects.{this.assignedcontrolled}.$vgo_runtime" exact="0" />
    <signal_objects object="this.assignedcontrolled" param="'vardath.go.restart34'" />
  </patch>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <do_if value="not $simfallback? or @$simfallback == null">
        <set_value name="$simfallback" exact="true" />
      </do_if>
      <do_if value="not $miningtime? or @$miningtime == null">
        <set_value name="$miningtime" exact="5min" />
      </do_if>
      <do_if value="not $batchsize? or @$batchsize == null">
        <set_value name="$batchsize" exact="24" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_runtime" exact="34" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_simfallback" exact="$simfallback" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_miningtime" exact="[[$miningtime,1min].max,30min].min" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_batchsize" exact="[[$batchsize,1].max,60].min" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_hack_forcedstation" exact="$hackstation" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_hack_forcedpanel" exact="$hackpanel" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_hack_once" exact="$hackonce" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_home" exact="$home" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_range" exact="$range" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_collectionlimit" exact="$collectionlimit" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_job" exact="$job" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_order" exact="this.ship.order" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_risk" exact="$risk" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_minreward" exact="$minreward" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_preferred" exact="if $preferred.exists then $preferred.owner else null" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_debug" exact="$debugchance" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_basechance" exact="$basechance" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_cooldown" exact="$cooldown" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_sell" exact="$sell" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_sellthreshold" exact="$sellthreshold" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_beamonly" exact="$beamonly" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_transit" exact="$transit" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_collect" exact="$collect" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_resourceonly" exact="$resourceonly" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_viewtime" exact="$viewtime" />
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_serial?">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_serial" exact="0" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_crystal_simulated? or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_simulated == null">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_simulated" exact="0" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_crystal_physical? or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_physical == null">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_physical" exact="0" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sold? or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sold == null">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sold" exact="0" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sent? or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sent == null">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sent" exact="0" />
      </do_if>
      <signal_objects object="player.entity" param="'vardath.go.register'" param2="this.ship" />
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_navigation_version != 2 or @player.entity.$vgo_objects.{this.ship}.$vgo_searchhome != $home or @player.entity.$vgo_objects.{this.ship}.$vgo_searchrange != $range">
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_scope" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_catalogue" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="false" />
      </do_if>
      <set_value name="$sectors" exact="if @player.entity.$vgo_objects.{this.ship}.$vgo_navigation_version == 2 and @player.entity.$vgo_objects.{this.ship}.$vgo_searchjob == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_searchhome == $home and @player.entity.$vgo_objects.{this.ship}.$vgo_searchrange == $range and player.entity.$vgo_objects.{this.ship}.$vgo_sectors? and @player.entity.$vgo_objects.{this.ship}.$vgo_sectors != null then player.entity.$vgo_objects.{this.ship}.$vgo_sectors.clone else []" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_navigation_version" exact="2" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_searchrange" exact="$range" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_searchhome" exact="$home" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_searchjob" exact="$job" />
      <do_if value="not $sectors? or @$sectors == null">
        <set_value name="$sectors" exact="[]" />
      </do_if>
      <set_value name="$done" exact="false" />
      <set_value name="$target" exact="null" />
      <label name="start" />
      <do_if value="not $sectors? or @$sectors == null">
        <set_value name="$sectors" exact="[]" />
      </do_if>
      <set_order_syncpoint_reached order="this.ship.order" />
      <do_if value="not this.ship.isplayerowned">
        <return />
      </do_if>
      <do_if value="this.ship == player.occupiedship or ($done and not $repeat)">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Standing by: player control or one assignment completed'" />
        <set_command_action commandaction="commandaction.standingby" />
        <wait exact="10s" />
        <resume label="start" />
      </do_if>
      <do_if value="$job == 8 and this.ship.iscapitalship">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Physical harvesting requires an S/M ship'" />
        <set_command_action commandaction="commandaction.standingby" />
        <wait min="25s" max="35s" />
        <resume label="start" />
      </do_if>
      <do_if value="not this.ship.sector.exists">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Occupation waiting for this ship to leave transit and enter a sector'" />
        <wait exact="5s" />
        <resume label="start" />
      </do_if>
      <do_if value="not $home.exists">
        <set_value name="$home" exact="this.ship.sector" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_home" exact="$home" />
      </do_if>
      <do_if value="$job == 3 and (this.ship.iscapitalship or this.ship.maxscanlevel le 0 or player.maxscanlevel le 0)">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="if this.ship.iscapitalship then 'Scanner waiting: this survey requires an S/M ship; a capital ship is assigned' else (if this.ship.maxscanlevel le 0 then 'Scanner waiting: assigned ship has no usable scanner software' else 'Scanner waiting: the native player discovery scanner cap is zero; enter a scanner-equipped ship')" />
        <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_survey_warning != player.entity.$vgo_objects.{this.ship}.$vgo_status">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_survey_warning" exact="player.entity.$vgo_objects.{this.ship}.$vgo_status" />
          <write_to_logbook category="general" title="'Galactic Occupations: scanner prerequisite'" text="this.ship.knownname + ': ' + player.entity.$vgo_objects.{this.ship}.$vgo_status" />
          <debug_text text="'GO scanner prerequisite: %1 ship_class=%2 ship_cap=%3 player_cap=%4'.[this.ship.debugname,this.ship.class,this.ship.maxscanlevel,player.maxscanlevel]" />
        </do_if>
        <wait exact="1min" />
        <resume label="start" />
      </do_if>
      <do_if value="$job == 6 and (@player.entity.$vgo_objects.{this.ship}.$vgo_crystal_order != this.ship.order or not @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_configured or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_all)">
        <find_object_component name="$turrets" object="this.ship" class="class.turret" multiple="true" />
        <do_for_each name="$turret" in="$turrets">
          <do_if value="not $turret.isrepairing">
            <do_if value="not player.entity.$vgo_objects.{$turret}?">
              <set_value name="player.entity.$vgo_objects.{$turret}" exact="table[]" />
            </do_if>
            <set_value name="player.entity.$vgo_objects.{$turret}.$vgo_minecrystals" exact="true" />
          </do_if>
        </do_for_each>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_all" exact="true" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_configured" exact="true" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_order" exact="this.ship.order" />
      </do_if>
      <do_if value="$job == 6">
        <find_object_component name="$crystal_turrets" object="this.ship" class="class.turret" multiple="true" />
        <set_value name="$compatible_turrets" exact="0" />
        <do_for_each name="$turret" in="$crystal_turrets">
          <do_if value="not $turret.isrepairing and @player.entity.$vgo_objects.{$turret}.$vgo_minecrystals">
            <set_value name="$compatible_turrets" exact="$compatible_turrets + 1" />
          </do_if>
        </do_for_each>
        <do_if value="$compatible_turrets == 0 and this.ship.maxcombatrange.lasers.all le 0 and this.ship.maxcombatrange.missiles.all le 0">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Crystal miner waiting: fit a forward weapon or enable Mine Crystals on an installed turret; no beam or ship-size restriction'" />
          <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_lastwarning != player.entity.$vgo_objects.{this.ship}.$vgo_status">
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_lastwarning" exact="player.entity.$vgo_objects.{this.ship}.$vgo_status" />
            <write_to_logbook category="general" title="'Galactic Occupations: crystal miner waiting'" text="this.ship.knownname + ': ' + player.entity.$vgo_objects.{this.ship}.$vgo_status" />
          </do_if>
          <set_command_action commandaction="commandaction.standingby" />
          <wait min="25s" max="35s" />
          <resume label="start" />
        </do_if>
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_scope.count or @player.entity.$vgo_objects.{this.ship}.$vgo_scope_until lt player.age">
        <run_script name="'vardath.go.scope'" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_scope.count">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'No accessible sectors in operating range; check range, home and risk settings'" />
        <wait exact="1min" />
        <resume label="start" />
      </do_if>
      <do_if value="$job == 6">
        <run_script name="'vardath.go.crystal.commercial'" result="$crystalcycle" />
        <do_if value="$crystalcycle == 1">
          <set_value name="$done" exact="true" />
          <run_script name="'vardath.go.recordresult'">
            <param name="outcome" value="'completed'" />
          </run_script>
        </do_if>
        <run_script name="'vardath.go.recordresult'">
          <param name="outcome" value="'deferred'" />
        </run_script>
        <run_script name="'vardath.go.release'" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_target" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" />
        <set_value name="$target" exact="null" />
        <do_if value="$crystalcycle == 0">
          <resume label="nextsector" />
        </do_if>
        <wait min="20s" max="30s" />
        <resume label="start" />
      </do_if>
      <do_if value="$job != 5 and not player.entity.$vgo_objects.{this.ship}.$vgo_scope.indexof.{this.ship.sector} and not (($job == 1 or $job == 12) and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_job == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_target.isoperational) and not ($job == 2 and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.exists)">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="not (($job == 1 or $job == 12) and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_job == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_target.isoperational)" />
      </do_if>
      <do_if value="$job == 13 and ($hackonce or @player.entity.$vgo_objects.{this.ship}.$vgo_hack_phase)">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="false" />
      </do_if>
      <do_if value="$job != 5 and @player.entity.$vgo_objects.{this.ship}.$vgo_rotate and not (($job == 1 or $job == 12) and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_job == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_target.isoperational) and not ($job == 2 and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.exists)">
        <resume label="nextsector" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Searching for an assignment'" />
      <set_command_action commandaction="commandaction.calculating" />
      <wait min="2s" max="8s" />
      <run_script name="'vardath.go.find'" result="$target">
        <param name="job" value="$job" />
      </run_script>
      <do_if value="$job == 13 and $hackonce and not $target.exists">
        <write_to_logbook category="general" title="'Galactic Occupations: requested hack unavailable'" text="this.ship.knownname + ': requested station is unavailable; queued hack ended without success'" />
        <return value="false" />
      </do_if>
      <label name="nextsector" />
      <do_if value="not $sectors? or @$sectors == null">
        <set_value name="$sectors" exact="[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_scope? or @player.entity.$vgo_objects.{this.ship}.$vgo_scope == null">
        <run_script name="'vardath.go.scope'" />
        <set_value name="$sectors" exact="[]" />
      </do_if>
      <do_if value="not $target.exists or ($job != 5 and @player.entity.$vgo_objects.{this.ship}.$vgo_rotate and not (($job == 1 or $job == 12) and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_job == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_target.isoperational) and not ($job == 2 and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.exists))">
        <do_if value="$job == 5">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'No unvisited accessible tour destination; checking again shortly'" />
          <wait min="40s" max="60s" />
          <resume label="start" />
        </do_if>
        <do_if value="not $sectors.count">
          <set_value name="$sectors" exact="if player.entity.$vgo_objects.{this.ship}.$vgo_scope? and @player.entity.$vgo_objects.{this.ship}.$vgo_scope != null then player.entity.$vgo_objects.{this.ship}.$vgo_scope.clone else []" />
        </do_if>
        <do_if value="$sectors.count gt 1 and $sectors.indexof.{this.ship.sector}">
          <remove_value name="$sectors.{$sectors.indexof.{this.ship.sector}}" />
        </do_if>
        <do_if value="$sectors.count">
          <set_value name="$next" exact="$sectors.random" />
          <remove_value name="$sectors.{$sectors.indexof.{$next}}" />
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_sectors" exact="$sectors" />
          <do_if value="$next.exists and ($risk == 2 or not $next.owner.hasrelation.enemy.{faction.player})">
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 30min" />
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" exact="$next" />
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Seeking work in ' + $next.knownname" />
            <run_script name="'vardath.go.depart'" result="$departed" />
            <do_if value="not $departed">
              <wait exact="10s" />
              <resume label="start" />
            </do_if>
            <run_script name="'vardath.go.travel'" result="$travelresult">
              <param name="destination" value="$next" />
            </run_script>
            <debug_text text="'GO sector travel: %1 destination=%2 native_result=%3 actual_sector=%4'.[this.ship.debugname,$next.knownname,$travelresult,if this.ship.sector.exists then this.ship.sector.knownname else 'In transit']" />
            <do_if value="not this.ship.sector.exists or this.ship.sector != $next">
              <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Sector travel did not reach ' + $next.knownname + '; check route, blacklist and ship restrictions; trying another permitted sector'" />
            </do_if>
          </do_if>
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="false" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" />
        <wait min="5s" max="10s" />
        <resume label="start" />
      </do_if>
      <do_if value="$job == 13 and @player.entity.$vgo_objects.{$target}.$vgo_owner.exists and @player.entity.$vgo_objects.{$target}.$vgo_owner != this.ship and @player.entity.$vgo_objects.{$target}.$vgo_expires gt player.age">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Hacker waiting: station reserved by another occupation ship'" />
        <wait min="10s" max="20s" />
        <resume label="start" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{$target}?">
        <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{$target}.$vgo_owner" exact="this.ship" />
      <do_if value="not player.entity.$vgo_objects.{$target}?">
        <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{$target}.$vgo_expires" exact="player.age + 25min" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_target" exact="$target" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_serial" exact="player.entity.$vgo_objects.{this.ship}.$vgo_serial + 1" />
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" />
      <run_script name="'vardath.go.recordresult'">
        <param name="outcome" value="'started'" />
      </run_script>
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_verified" exact="false" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_reward" exact="0Cr" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rewardfaction" exact="null" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 20min" />
      <set_value name="$success" exact="false" />
      <debug_text text="'GO: %s job %s target %s'.[this.ship.debugname, $job, $target.debugname]" chance="$debugchance" />
      <do_if value="$job == 1">
        <run_script name="'vardath.go.task.escort'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_if>
      <do_elseif value="$job == 2">
        <run_script name="'vardath.go.task.taxi'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 3">
        <run_script name="'vardath.go.task.scanner'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 4">
        <run_script name="'vardath.go.task.mapper'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 5">
        <run_script name="'vardath.go.task.tour'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 6">
        <run_script name="'vardath.go.task.crystal'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 7">
        <run_script name="'vardath.go.task.lure'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 8">
        <run_script name="'vardath.go.task.demolition'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 9">
        <run_script name="'vardath.go.task.morale'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 10">
        <run_script name="'vardath.go.task.inspection'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 11">
        <run_script name="'vardath.go.task.recruit'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 12">
        <run_script name="'vardath.go.task.patrol'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_elseif value="$job == 13">
        <run_script name="'vardath.go.task.hacker'" result="$success">
          <param name="target" value="$target" />
        </run_script>
      </do_elseif>
      <do_if value="$success">
        <set_value name="$done" exact="true" />
        <run_script name="'vardath.go.recordresult'">
          <param name="outcome" value="'completed'" />
        </run_script>
        <run_script name="'vardath.go.reward'" />
      </do_if>
      <label name="cleanup" />
      <run_script name="'vardath.go.recordresult'">
        <param name="outcome" value="'deferred'" />
      </run_script>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rotate" exact="not (($job == 1 or $job == 12) and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_job == $job and @player.entity.$vgo_objects.{this.ship}.$vgo_convoy_target.isoperational)" />
      <run_script name="'vardath.go.release'" />
      <do_if value="@$target.exists and @player.entity.$vgo_objects.{$target}.$vgo_owner == this.ship">
        <do_if value="not player.entity.$vgo_objects.{$target}?">
          <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
        </do_if>
        <remove_value name="player.entity.$vgo_objects.{$target}.$vgo_owner" />
        <do_if value="not player.entity.$vgo_objects.{$target}?">
          <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
        </do_if>
        <remove_value name="player.entity.$vgo_objects.{$target}.$vgo_expires" />
        <do_if value="not player.entity.$vgo_objects.{$target}.$vgo_cooldowns?">
          <do_if value="not player.entity.$vgo_objects.{$target}?">
            <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$target}.$vgo_cooldowns" exact="table[]" />
        </do_if>
        <do_if value="not player.entity.$vgo_objects.{$target}.$vgo_cooldowns.{$job}? or player.entity.$vgo_objects.{$target}.$vgo_cooldowns.{$job} lt player.age + 5min">
          <do_if value="not player.entity.$vgo_objects.{$target}?">
            <set_value name="player.entity.$vgo_objects.{$target}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$target}.$vgo_cooldowns.{$job}" exact="player.age + 5min" />
        </do_if>
      </do_if>
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_target" />
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" />
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" />
      <do_if value="$job == 13 and $hackonce and $target == $hackstation">
        <return value="$success" />
      </do_if>
      <wait min="10s" max="20s" />
      <resume label="start" />
    </actions>
  </attention>
</aiscript>