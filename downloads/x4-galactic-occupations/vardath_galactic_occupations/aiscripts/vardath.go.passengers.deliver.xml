<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.passengers.deliver" version="7" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params />
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <set_value name="$destination" exact="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest" />
      <do_if value="not $destination.isoperational">
        <return value="0" />
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_boarded or not @player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count">
        <return value="0" />
      </do_if>
      <do_if value="@this.ship.dock.container != $destination">
        <run_script name="'vardath.go.depart'" result="$departed" />
        <do_if value="not $departed">
          <return value="0" />
        </do_if>
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Passenger service: ' + player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count + ' booked passengers, travelling to ' + $destination.knownname" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_destination" exact="$destination" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 45min" />
      <do_if value="this.ship.sector != $destination.sector">
        <run_script name="'vardath.go.depart'" result="$departed" />
        <do_if value="not $departed">
          <return value="0" />
        </do_if>
        <run_script name="'vardath.go.travel'" result="$vgo_arrived">
          <param name="destination" value="$destination.sector" />
        </run_script>
        <do_if value="not $vgo_arrived">
          <return value="0" />
        </do_if>
      </do_if>
      <run_script name="'vardath.go.dock'" result="$vgo_docked">
        <param name="destination" value="$destination" />
        <param name="waittime" value="5min" />
      </run_script>
      <do_if value="not $vgo_docked">
        <return value="0" />
      </do_if>
      <do_if value="@this.ship.dock.container != $destination or not @player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count">
        <return value="0" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered" exact="false" />
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_taxi_phase != 'disembarking'">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_phase_started" exact="player.age" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_phase" exact="'disembarking'" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Passenger service: docked, waiting for passenger to disembark'" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 6min" />
      <do_while value="@this.ship.dock.container == $destination and not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_phase == 'disembarking'">
        <wait exact="2s" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 6min" />
        <do_if value="player.age gt player.entity.$vgo_objects.{this.ship}.$vgo_taxi_phase_started + 5min">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Passenger service: disembarkation path retry; no fare until every passenger leaves'" />
          <return value="0" />
        </do_if>
      </do_while>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered">
        <return value="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count" />
      </do_if>
      <return value="0" />
    </actions>
  </attention>
</aiscript>
