<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.fire" version="6" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target" />
    <param name="crystal" default="true" />
  </params>
  <interrupts>
    <handler>
      <conditions>
        <event_object_destroyed object="$target" check="false" />
      </conditions>
      <actions>
        <set_value name="$destroyed" exact="true" />
      </actions>
    </handler>
  </interrupts>
  <attention min="visible">
    <actions>
      <set_value name="$destroyed" exact="false" />
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <do_if value="not $target.exists or this.ship.attention lt attention.visible or (not $crystal and this.ship.iscapitalship)">
        <return value="false" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_persistent_rock" exact="if $crystal then $target.parent else $target" />
      <set_region_object_persistence object="if $crystal then $target.parent else $target" chance="100" />
      <set_value name="$initialhull" exact="$target.hull" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_turrets" exact="[]" />
      <find_object_component name="$allturrets" object="this.ship" class="class.turret" multiple="true" checkoperational="true" />
      <do_for_each name="$turret" in="$allturrets">
        <do_if value="not $turret.isrepairing and (not $crystal or @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_configured != true or @player.entity.$vgo_objects.{$turret}.$vgo_minecrystals)">
          <append_to_list name="player.entity.$vgo_objects.{this.ship}.$vgo_turrets" exact="$turret" />
        </do_if>
      </do_for_each>
      <do_if value="$crystal and not player.entity.$vgo_objects.{this.ship}.$vgo_turrets.count and this.ship.maxcombatrange.lasers.all le 0 and this.ship.maxcombatrange.missiles.all le 0">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'No selected offensive turret or forward weapon is available for crystal harvesting'" />
        <return value="false" />
      </do_if>
      <set_value name="$range" exact="if this.ship.maxcombatrange.lasers.all gt 0 then this.ship.maxcombatrange.lasers.all * 0.75 else this.ship.maxcombatrange.missiles.all * 0.75" />
      <do_for_each name="$turret" in="player.entity.$vgo_objects.{this.ship}.$vgo_turrets">
        <do_if value="$turret.maxfirerange gt 0">
          <set_value name="$range" exact="if $range gt 0 then [$range, $turret.maxfirerange * 0.75].min else $turret.maxfirerange * 0.75" />
        </do_if>
      </do_for_each>
      <set_value name="$approachdistance" exact="$range + this.ship.size / 2" />
      <do_if value="$range le 0m">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'No usable weapon range for this harvesting or demolition target'" />
        <return value="false" />
      </do_if>
      <run_script name="'vardath.go.approach'" result="$ok">
        <param name="target" value="$target" />
        <param name="distance" value="$approachdistance" />
      </run_script>
      <do_if value="not $ok">
        <return value="false" />
      </do_if>
      <set_value name="$arc" exact="1" />
      <run_script name="'vardath.go.aligncrystal'" result="$aligned">
        <param name="target" value="$target" />
        <param name="arc" value="1" />
      </run_script>
      <do_if value="not $target.exists">
        <return value="false" />
      </do_if>
      <set_value name="$lastdamage" exact="player.age" />
      <set_value name="$previoushull" exact="$target.hull" />
      <set_value name="$end" exact="player.age + 5min" />
      <debug_text text="'GO crystals/fire: %s target %s; selected turrets %s; forward laser range %s; missile range %s; ship class %s'.[this.ship.debugname,$target.debugname,player.entity.$vgo_objects.{this.ship}.$vgo_turrets.count,this.ship.maxcombatrange.lasers.all,this.ship.maxcombatrange.missiles.all,this.ship.class]" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_firing" exact="true" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="if $crystal then 'Mine Crystals: aiming at the deposit' else 'Demolishing asteroid'" />
      <do_while value="$target.exists and $target.hull gt 0 and player.age lt $end and this.ship.attention ge attention.visible">
        <do_if value="this.ship.hullpercentage lt 65 or (this.ship.maxshield gt 0 and this.ship.shieldpercentage lt 25)">
          <break />
        </do_if>
        <do_if value="$target.hull lt $previoushull">
          <set_value name="$lastdamage" exact="player.age" />
          <set_value name="$previoushull" exact="$target.hull" />
        </do_if>
        <do_if value="player.age gt $lastdamage + 20s">
          <do_if value="$arc lt 4">
            <set_value name="$arc" exact="$arc + 1" />
            <run_script name="'vardath.go.aligncrystal'">
              <param name="target" value="$target" />
              <param name="arc" value="$arc" />
            </run_script>
            <set_value name="$lastdamage" exact="player.age" />
            <continue />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Firing stopped: no damage after trying front, left, right and rear orientations; check ammunition, range or weapon compatibility'" />
          <break />
        </do_if>
        <find_ship name="$nearby" space="$target.sector" excluded="this.ship" multiple="true">
          <match_distance object="$target" max="1500m" />
        </find_ship>
        <set_value name="$unsafe" exact="false" />
        <do_for_each name="$ship" in="$nearby">
          <do_if value="not $ship.ishostileto.{this.ship}">
            <set_value name="$unsafe" exact="true" />
            <break />
          </do_if>
        </do_for_each>
        <find_station name="$nearstation" space="$target.sector">
          <match_distance object="$target" max="5km" />
        </find_station>
        <do_if value="$unsafe or $nearstation.exists">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Firing withheld: nearby traffic or station'" />
          <break />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_fireuntil" exact="player.age + 3s" />
        <set_value name="$canfire" exact="false" />
        <do_for_each name="$turret" in="player.entity.$vgo_objects.{this.ship}.$vgo_turrets">
          <do_if value="$turret.isoperational and $turret.distanceto.{$target} le $turret.maxfirerange * 0.9 and (not $crystal or @player.entity.$vgo_objects.{$turret}.$vgo_minecrystals)">
            <check_line_of_sight name="$los" object="$turret" target="$target" useaimtarget="true" />
            <do_if value="$los">
              <aim_turret turret="$turret" target="$target" />
              <set_value name="$canfire" exact="true" />
            </do_if>
            <do_else>
              <reset_turret turret="$turret" />
            </do_else>
          </do_if>
        </do_for_each>
        <wait exact="500ms" />
        <do_if value="not $target.exists">
          <break />
        </do_if>
        <do_for_each name="$turret" in="player.entity.$vgo_objects.{this.ship}.$vgo_turrets">
          <do_if value="$turret.isoperational and $turret.isreadytofire and $turret.distanceto.{$target} le $turret.maxfirerange * 0.9 and (not $crystal or @player.entity.$vgo_objects.{$turret}.$vgo_minecrystals)">
            <check_line_of_sight name="$los" object="$turret" target="$target" useaimtarget="true" />
            <do_if value="$los">
              <fire_turret turret="$turret" />
            </do_if>
          </do_if>
        </do_for_each>
        <do_if value="this.ship.maxcombatrange.lasers.all gt 0 or this.ship.maxcombatrange.missiles.all gt 0">
          <check_line_of_sight name="$los" object="this.ship" target="$target" useaimtarget="true" />
          <do_if value="$los">
            <shoot_at object="this.ship" target="$target" fixedtarget="true" missiles="this.ship.maxcombatrange.lasers.all le 0" tolerance="1deg" />
          </do_if>
        </do_if>
        <wait exact="500ms" />
      </do_while>
      <run_script name="'vardath.go.release'" />
      <do_if value="$crystal">
        <debug_text text="'GO crystal fire result: %1 target_exists=%2 destroyed_event=%3 initial_hull=%4 remaining_hull=%5'.[this.ship.debugname,$target.exists,$destroyed,$initialhull,if $target.exists then $target.hull else 0]" />
      </do_if>
      <do_if value="$destroyed">
        <return value="true" />
      </do_if>
      <do_if value="$target.exists">
        <return value="$target.hull le 0" />
      </do_if>
      <return value="false" />
    </actions>
  </attention>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Physical weapon operation requires visible attention; searching elsewhere'" />
      <return value="false" />
    </actions>
  </attention>
</aiscript>