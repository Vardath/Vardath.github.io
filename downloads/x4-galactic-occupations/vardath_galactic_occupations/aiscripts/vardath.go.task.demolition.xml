<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.task.demolition" version="5" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target" />
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <do_if value="not $target.isclass.asteroid or $target.isinvulnerable or $target.isindestructible">
        <return value="false" />
      </do_if>
      <run_script name="'vardath.go.fire'" result="$destroyed">
        <param name="target" value="$target" />
        <param name="crystal" value="false" />
      </run_script>
      <do_if value="$destroyed and player.entity.$vgo_objects.{this.ship}.$vgo_collect">
        <find_object name="$drops" space="this.ship.zone" class="class.drop" multiple="true">
          <match_distance object="this.ship" max="5km" />
        </find_object>
        <do_if value="$drops.count">
          <run_script name="'order.collect.ship'">
            <param name="targetlist" value="$drops" />
          </run_script>
        </do_if>
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'Destructible asteroid destroyed; native destruction event or zero hull confirmed'" />
      <return value="$destroyed" />
    </actions>
  </attention>
</aiscript>