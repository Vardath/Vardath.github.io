<?xml version='1.0' encoding='utf-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.task.scanner" version="8" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target" />
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <do_if value="not $target.isoperational or this.ship.maxscanlevel le 0">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Component survey requires scanner software'" />
        <return value="false" />
      </do_if>
      <run_script name="'vardath.go.scanmodules'" result="$modules">
        <param name="station" value="$target" />
      </run_script>
      <set_value name="$count" exact="0" />
      <set_value name="$pendingcount" exact="0" />
      <set_value name="$geometrymissing" exact="false" />
      <set_value name="$stationbefore" exact="$target.revealedpercentage" />
      <do_for_each name="$module" in="$modules">
        <do_if value="not $module.isoperational or $module.scannedlevel ge this.ship.maxscanlevel">
          <continue />
        </do_if>
        <run_script name="'vardath.go.approach'" result="$ok">
          <param name="target" value="$module" />
          <param name="distance" value="2km" />
        </run_script>
        <do_if value="not $ok">
          <do_if value="not player.entity.$vgo_objects.{$module}?">
            <set_value name="player.entity.$vgo_objects.{$module}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_retry" exact="player.age + 10min" />
          <continue />
        </do_if>
        <do_if value="(not this.ship.order.$simulatescans? or this.ship.order.$simulatescans) and ($module.sector != player.sector or $module.attention lt attention.visible or not $module.isphysicsready)">
          <set_value name="$remotelevel" exact="$module.scannedlevel" />
          <set_value name="$remotepct" exact="$module.revealedpercentage" />
          <run_script name="'vardath.go.survey.remote'" result="$remotechanged">
            <param name="station" value="$target" />
            <param name="module" value="$module" />
          </run_script>
          <do_if value="$remotechanged">
            <set_value name="$count" exact="$count + 1" />
            <do_if value="@player.entity.$vgo_objects.{$module}.$vgo_survey_queued and $module.scannedlevel lt this.ship.maxscanlevel">
              <set_value name="$pendingcount" exact="$pendingcount + 1" />
            </do_if>
          </do_if>
          <do_if value="$count ge 8">
            <break />
          </do_if>
          <continue />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Finding a visible survey surface on ' + $module.knownname" />
        <do_all exact="10">
          <do_if value="$module.isphysicsready and $module.attention ge attention.visible and $module.sector == player.sector">
            <break />
          </do_if>
          <wait exact="2s" />
        </do_all>
        <do_if value="not $module.isphysicsready or $module.attention lt attention.visible or $module.sector != player.sector">
          <set_value name="$geometrymissing" exact="true" />
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Survey needs loaded component collision geometry; moving to another target'" />
          <do_if value="not player.entity.$vgo_objects.{$module}?">
            <set_value name="player.entity.$vgo_objects.{$module}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_retry" exact="player.age + 5min" />
          <break />
        </do_if>
        <set_value name="$scanned" exact="false" />
        <do_all exact="3" counter="$attempt">
          <do_if value="not $module.isoperational or not $module.isphysicsready or $module.attention lt attention.visible or $module.sector != player.sector or $target.ishostileto.{this.ship}">
            <break />
          </do_if>
          <do_if value="$attempt == 1">
            <find_object_surface object="$module" posname="$surface" space="$module.sector" height="500m + this.ship.size / 2" tolerateneighbour="false">
              <position object="this.ship" />
            </find_object_surface>
          </do_if>
          <do_else>
            <find_object_surface object="$module" posname="$surface" space="$module.sector" height="500m + this.ship.size / 2" tolerateneighbour="false" />
          </do_else>
          <do_if value="not $surface">
            <continue />
          </do_if>
          <run_script name="'vardath.go.depart'" result="$departed" />
          <do_if value="not $departed">
            <return value="false" />
          </do_if>
          <run_script name="'move.generic'">
            <param name="destination" value="$module.sector" />
            <param name="position" value="$surface" />
            <param name="strictblacklist" value="true" />
            <param name="useknownpath" value="false" />
            <param name="pursuetargets" value="false" />
          </run_script>
          <set_command_action commandaction="commandaction.scanningto" param="$module" />
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Surveying ' + $module.knownname + ' on ' + $target.knownname + ' (' + $count + ' completed)'" />
          <set_value name="$sample_started" exact="player.age" />
          <set_value name="$valid" exact="true" />
          <do_all exact="10">
            <do_if value="not $module.isoperational or not $module.isphysicsready or $module.attention lt attention.visible or $module.sector != player.sector or this.ship.sector != $module.sector or this.ship.distanceto.{$module} gt 800m + ($module.size + this.ship.size) / 2 or $target.ishostileto.{this.ship}">
              <set_value name="$valid" exact="false" />
              <break />
            </do_if>
            <check_line_of_sight name="$los" object="this.ship" target="$module" useaimtarget="true" />
            <do_if value="not $los">
              <set_value name="$valid" exact="false" />
              <break />
            </do_if>
            <wait exact="1s" />
          </do_all>
          <do_if value="$valid and $module.isoperational">
            <set_value name="$before" exact="$module.revealedpercentage" />
            <set_value name="$levelbefore" exact="$module.scannedlevel" />
            <run_script name="'vardath.go.survey.publish'" result="$publication" sinceversion="7">
              <param name="station" value="$target" />
              <param name="module" value="$module" />
              <param name="started" value="$sample_started" />
            </run_script>
            <set_known object="$module" known="true" />
            <do_if value="@$publication gt 0">
              <set_value name="$count" exact="$count + 1" />
              <set_value name="$scanned" exact="true" />
              <do_if value="not player.entity.$vgo_objects.{$module}?">
                <set_value name="player.entity.$vgo_objects.{$module}" exact="table[]" />
              </do_if>
              <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_level" exact="$module.scannedlevel" />
              <do_if value="not player.entity.$vgo_objects.{$module}?">
                <set_value name="player.entity.$vgo_objects.{$module}" exact="table[]" />
              </do_if>
              <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_time" exact="player.age" />
              <set_known object="$target" known="true" updatesnapshot="true" />
              <do_if value="@$publication == 1">
                <set_value name="$pendingcount" exact="$pendingcount + 1" />
              </do_if>
            </do_if>
            <debug_text text="'GO: module survey %s level %s to %s reveal %s to %s'.[$module.debugname,$levelbefore,$module.scannedlevel,$before,$module.revealedpercentage]" chance="player.entity.$vgo_objects.{this.ship}.$vgo_debug" />
            <break />
          </do_if>
        </do_all>
        <do_if value="not $scanned">
          <do_if value="not player.entity.$vgo_objects.{$module}?">
            <set_value name="player.entity.$vgo_objects.{$module}" exact="table[]" />
          </do_if>
          <set_value name="player.entity.$vgo_objects.{$module}.$vgo_survey_retry" exact="player.age + 10min" />
        </do_if>
        <do_if value="$count ge 8">
          <break />
        </do_if>
        <wait exact="500ms" />
      </do_for_each>
      <run_script name="'vardath.go.task.leaks'" result="$leakcount">
        <param name="station" value="$target" />
      </run_script>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="if $geometrymissing then 'Component survey waiting for loaded collision geometry at ' + $target.knownname + '; enable simulation for off-screen work' else ('Surveyed ' + $count + ' components at ' + $target.knownname + '; queued native scan publications: ' + $pendingcount + '; signal-leak surveys: ' + $leakcount)" />
      <do_if value="$count">
        <write_to_logbook category="general" title="'Galactic Occupations: component survey'" text="'%1 surveyed %2 components of %3. Native discovery %4 to %5 percent; %6 scan publications queued because the player scanner context is unavailable or lower level.'.[this.ship.knownname,$count,$target.knownname,$stationbefore,$target.revealedpercentage,$pendingcount]" interaction="showonmap" object="$target" />
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'' + $count + ' components surveyed at ' + $target.knownname + '; native scan publications pending: ' + $pendingcount + '; native station discovery ' + $target.revealedpercentage + '%; signal-leak surveys: ' + $leakcount" />
      <return value="$count gt 0 or $leakcount gt 0" />
    </actions>
  </attention>
</aiscript>
