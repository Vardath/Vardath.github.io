<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.task.taxi" version="8" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target" />
  </params>
  <patch sinceversion="5">
    <set_value name="$remaining" exact="[]" />
    <set_value name="$sectors" exact="[]" />
    <set_value name="$stations" exact="[]" />
    <set_value name="$destination" exact="null" />
  </patch>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]" />
      </do_if>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_completed_service == 2 and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_completed_id != @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_paid_id">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_verified" exact="true" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_reward" exact="8000Cr * player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rewardfaction" exact="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_faction" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count + ' passengers disembarked at ' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.knownname" />
        <return value="true" />
      </do_if>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count and @player.entity.$vgo_objects.{this.ship}.$vgo_passenger_service != 2">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Finish the existing passenger service before starting a taxi journey'" />
        <return value="false" />
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_pickup.exists and not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_boarded">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_pickup" exact="$target" />
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count and not (player.entity.$vgo_objects.{this.ship}.$vgo_passenger? and @this.ship.people.{player.entity.$vgo_objects.{this.ship}.$vgo_passenger}.exists) and not this.ship.people.free">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Taxi waiting for a free crew berth'" />
        <return value="false" />
      </do_if>
      <do_if value="8000Cr * [10, this.ship.people.free + @player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count].min lt player.entity.$vgo_objects.{this.ship}.$vgo_minreward and not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_boarded">
        <return value="false" />
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.isoperational or not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.dockingallowed.{this.ship} or not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.haswalkableroom or (@player.entity.$vgo_objects.{this.ship}.$vgo_dock_failed_target == @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest and @player.entity.$vgo_objects.{this.ship}.$vgo_dock_retry gt player.age)">
        <set_value name="$sectors" exact="player.entity.$vgo_objects.{this.ship}.$vgo_scope.clone" />
        <set_value name="$destination" exact="null" />
        <do_all exact="2" counter="$pass">
          <set_value name="$remaining" exact="$sectors.clone" />
          <do_while value="$remaining.count">
            <set_value name="$sector" exact="$remaining.random" />
            <remove_value name="$remaining.{$remaining.indexof.{$sector}}" />
            <do_if value="$pass == 1 and $sector == @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_pickup.sector">
              <continue />
            </do_if>
            <find_station name="$stations" space="$sector" multiple="true" excluded="@player.entity.$vgo_objects.{this.ship}.$vgo_taxi_pickup" reachablefrom="this.ship" haswalkableroom="true">
              <match_dock size="this.ship.docksize" />
            </find_station>
            <do_while value="$stations.count">
              <set_value name="$station" exact="$stations.random" />
              <remove_value name="$stations.{$stations.indexof.{$station}}" />
              <do_if value="$station.isoperational and $station.dockingallowed.{this.ship} and not $station.ishostileto.{this.ship} and (player.entity.$vgo_objects.{this.ship}.$vgo_risk == 2 or not $station.sector.owner.hasrelation.enemy.{faction.player}) and not (@player.entity.$vgo_objects.{this.ship}.$vgo_dock_failed_target == $station and @player.entity.$vgo_objects.{this.ship}.$vgo_dock_retry gt player.age)">
                <set_value name="$destination" exact="$station" />
                <break />
              </do_if>
            </do_while>
            <do_if value="$destination.exists">
              <break />
            </do_if>
            <wait exact="100ms" />
          </do_while>
          <do_if value="$destination.exists">
            <break />
          </do_if>
        </do_all>
        <do_if value="not $destination.exists">
          <return value="false" />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest" exact="$destination" />
      </do_if>
      <run_script name="'vardath.go.passengers.board'" result="$boarded">
        <param name="target" value="$target" />
      </run_script>
      <do_if value="not $boarded">
        <return value="false" />
      </do_if>
      <run_script name="'vardath.go.passengers.deliver'" result="$delivered" />
      <do_if value="$delivered gt 0">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_verified" exact="true" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_reward" exact="8000Cr * $delivered" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rewardfaction" exact="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_faction" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count + ' passengers disembarked at ' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest.knownname" />
        <return value="true" />
      </do_if>
      <return value="false" />
    </actions>
  </attention>
</aiscript>