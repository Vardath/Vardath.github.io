<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.task.recruit" version="1" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target"/>
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="not $target.isoperational or not $target.iscapturable or $target.ismission or $target.hullpercentage ge 25 or not $target.ishostileto.{this.ship} or not $target.pilot.iscommable or @$target.pilot.ismissionactor">
        <return value="false"/>
      </do_if>
      <run_script name="'vardath.go.approach'" result="$ok">
        <param name="target" value="$target"/>
        <param name="distance" value="6km"/>
      </run_script>
      <do_if value="not $ok">
        <return value="false"/>
      </do_if>
      <set_value name="this.ship.$vgo_status" exact="'Negotiating emergency surrender'"/>
      <wait exact="8s"/>
      <do_if value="not $target.isoperational or not $target.iscapturable or $target.ismission or $target.isplayerowned or $target.hullpercentage ge 25 or not $target.ishostileto.{this.ship} or this.ship.sector != $target.sector or this.ship.distanceto.{$target} gt 8km + $target.size / 2 or @$target.pilot.ismissionactor">
        <return value="false"/>
      </do_if>
      <do_if value="not $target.$vgo_cooldowns?">
        <set_value name="$target.$vgo_cooldowns" exact="table[]"/>
      </do_if>
      <set_value name="$target.$vgo_cooldowns.{11}" exact="player.age + 30min"/>
      <set_value name="$classfactor" exact="if $target.iscapitalship then 0.25 else (if $target.isclass.ship_m then 0.6 else 1.0)"/>
      <set_value name="$morale" exact="@$target.pilot.skill.morale"/>
      <set_value name="$chance" exact="[this.ship.$vgo_basechance * $classfactor * (1 + (25 - $target.hullpercentage) / 25) * (1 - $morale / 30) / (1 + $target.people.count / 100), 50].min"/>
      <set_value name="$roll" min="0" max="100"/>
      <do_if value="$roll ge $chance">
        <return value="false"/>
      </do_if>
      <!-- Surrender changes the existing object. No replacement hull, refit or crew recreation. -->
      <cease_fire object="this.ship"/>
      <cease_fire object="$target"/>
      <remove_object_commander object="$target"/>
      <set_owner object="$target" faction="faction.player" overridenpc="true"/>
      <reset_relation_boost object="$target" faction="faction.player"/>
      <do_if value="$target.isplayerowned"><find_ship name="$nearby" space="$target.sector" owner="faction.player" multiple="true"/><do_for_each name="$attacker" in="$nearby"><do_for_each name="$attackorder" in="$attacker.orders" reverse="true"><do_if value="$attackorder.id == 'Attack' and @$attackorder.$primarytarget == $target"><cancel_order order="$attackorder"/></do_if></do_for_each></do_for_each></do_if><cancel_all_orders object="$target"/>
      <create_order object="$target" id="'Wait'" default="true"/>
      <reinitialise_control_entities object="$target"/>
      <write_to_logbook category="general" title="'Galactic Occupations: emergency recruitment'" text="'%s accepted surrender of %s at %s percent hull.'.[this.ship.knownname,$target.knownname,$target.hullpercentage]" interaction="showonmap" object="$target"/>
      <return value="$target.isplayerowned"/>
    </actions>
  </attention>
</aiscript>
