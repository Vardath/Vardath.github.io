<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.task.tour" version="7" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="target"/>
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="not player.entity.$vgo_objects?">
        <set_value name="player.entity.$vgo_objects" exact="table[]"/>
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}" exact="table[]"/>
      </do_if>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_completed_service == 5 and @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_completed_id != @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_paid_id">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_verified" exact="true"/>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_reward" exact="player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_fee * player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count"/>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rewardfaction" exact="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_faction"/>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count + ' luxury passengers disembarked after ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count + ' distinct sites in ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors.count + ' sectors'"/>
        <return value="true"/>
      </do_if>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count and @player.entity.$vgo_objects.{this.ship}.$vgo_passenger_service != 5">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Complete the existing taxi journey before taking tour passengers'"/>
        <return value="false"/>
      </do_if>
      <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_taxi_boarded">
        <do_if value="not @player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count">
          <do_if value="@this.ship.order.id == 'VGO_tour' and @this.ship.order.$stops ge 10 and @this.ship.order.$stops le 20">
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_stops" exact="this.ship.order.$stops"/>
          </do_if>
          <run_script name="'vardath.go.tourcatalogue'" result="$catalogue"/>
          <do_if value="$catalogue.count lt player.entity.$vgo_objects.{this.ship}.$vgo_tour_stops">
            <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Luxury tour needs ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_stops + ' distinct sites in the operating range; increase range'"/>
            <return value="false"/>
          </do_if>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip" exact="[]"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors" exact="[]"/>
          <set_value name="$sectors" exact="[]"/>
          <do_for_each name="$poi" in="$catalogue">
            <do_if value="not $sectors.indexof.{$poi.sector}">
              <append_to_list name="$sectors" exact="$poi.sector"/>
            </do_if>
          </do_for_each>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_minsectors" exact="[3, $sectors.count].min"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_stops" exact="player.entity.$vgo_objects.{this.ship}.$vgo_tour_stops"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_fee" exact="player.entity.$vgo_objects.{this.ship}.$vgo_tour_ticketfee"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_pickup" exact="$target"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_dest" exact="$target"/>
        </do_if>
        <run_script name="'vardath.go.passengers.board'" result="$boarded">
          <param name="target" value="$target"/>
        </run_script>
        <do_if value="not $boarded">
          <return value="false"/>
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Luxury tour: passengers aboard, selecting first sightseeing stop'"/>
        <run_script name="'vardath.go.find'" result="$nextstop">
          <param name="job" value="5"/>
        </run_script>
        <do_if value="not $nextstop.exists">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Luxury tour: passengers aboard; waiting for an accessible unvisited site'"/>
          <return value="false"/>
        </do_if>
        <set_value name="$target" exact="$nextstop"/>
      </do_if>
      <do_if value="player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count ge player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_stops and player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors.count ge player.entity.$vgo_objects.{this.ship}.$vgo_tour_minsectors">
        <run_script name="'vardath.go.passengers.deliver'" result="$delivered"/>
        <do_if value="$delivered gt 0">
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_verified" exact="true"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_reward" exact="player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_fee * $delivered"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_rewardfaction" exact="player.entity.$vgo_objects.{this.ship}.$vgo_taxi_faction"/>
          <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_result" exact="'' + player.entity.$vgo_objects.{this.ship}.$vgo_taxi_delivered_count + ' luxury passengers disembarked after ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count + ' distinct sites in ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors.count + ' sectors'"/>
          <return value="true"/>
        </do_if>
        <return value="false"/>
      </do_if>
      <do_if value="not $target.exists or @player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.indexof.{$target}">
        <return value="false"/>
      </do_if>
      <run_script name="'vardath.go.approach'" result="$ok">
        <param name="target" value="$target"/>
        <param name="distance" value="5km"/>
      </run_script>
      <do_if value="not $ok">
        <return value="false"/>
      </do_if>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Luxury tour: viewing ' + $target.knownname + ' (' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count + '/' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_stops + ')'"/>
      <set_command_action commandaction="commandaction.investigating" param="$target"/>
      <wait exact="player.entity.$vgo_objects.{this.ship}.$vgo_viewtime"/>
      <do_if value="not $target.exists or this.ship.sector != $target.sector or this.ship.distanceto.{$target} gt 8km + $target.size / 2">
        <return value="false"/>
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_tour?">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_tour" exact="[]"/>
      </do_if>
      <append_to_list name="player.entity.$vgo_objects.{this.ship}.$vgo_tour" exact="$target"/>
      <append_to_list name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip" exact="$target"/>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors.indexof.{$target.sector}">
        <append_to_list name="player.entity.$vgo_objects.{this.ship}.$vgo_tour_sectors" exact="$target.sector"/>
      </do_if>
      <set_known object="$target" known="true"/>
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Luxury tour: ' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count + '/' + player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_stops + ' sights visited; ' + player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count + ' passengers aboard'"/>
      <write_to_logbook category="general" title="'Galactic Occupations: luxury sightseeing'" text="'%s: stop %s/%s, %s in %s; %s passengers aboard.'.[this.ship.knownname,player.entity.$vgo_objects.{this.ship}.$vgo_tour_trip.count,player.entity.$vgo_objects.{this.ship}.$vgo_tour_booked_stops,$target.knownname,$target.sector.knownname,player.entity.$vgo_objects.{this.ship}.$vgo_passengers.count]" interaction="showonmap" object="$target"/>
      <return value="false"/>
    </actions>
  </attention>
</aiscript>
