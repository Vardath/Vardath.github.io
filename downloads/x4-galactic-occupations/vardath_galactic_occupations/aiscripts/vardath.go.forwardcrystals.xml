<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.forwardcrystals" version="2" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <attention min="unknown">
    <actions>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_crystal_commercial and @player.entity.$vgo_objects.{this.ship}.$vgo_job == 6">
        <run_script name="'vardath.go.crystal.stock'" result="$stored" />
        <return value="$stored" />
      </do_if>
      <set_value name="$forwarded" exact="0" />
      <do_if value="not this.ship.isplayerowned or not this.ship.pilot.exists or this.ship.pilot == player.entity">
        <return value="0" />
      </do_if>
      <do_for_each name="$ware" in="[ware.inv_crystal_01,ware.inv_crystal_02,ware.inv_crystal_03,ware.inv_crystal_04,ware.inv_crystal_05]">
        <set_value name="$sourcebefore" exact="this.ship.pilot.inventory.{$ware}.count" />
        <do_if value="$sourcebefore le 0">
          <continue />
        </do_if>
        <set_value name="$playerbefore" exact="player.entity.inventory.{$ware}.count" />
        <remove_inventory entity="this.ship.pilot" ware="$ware" exact="$sourcebefore" />
        <set_value name="$removed" exact="[$sourcebefore - this.ship.pilot.inventory.{$ware}.count, 0].max" />
        <do_if value="$removed le 0">
          <continue />
        </do_if>
        <add_inventory entity="player.entity" ware="$ware" exact="$removed" />
        <set_value name="$added" exact="[[player.entity.inventory.{$ware}.count - $playerbefore, 0].max, $removed].min" />
        <do_if value="$added lt $removed">
          <add_inventory entity="this.ship.pilot" ware="$ware" exact="$removed - $added" />
        </do_if>
        <set_value name="$forwarded" exact="$forwarded + $added" />
      </do_for_each>
      <do_if value="$forwarded gt 0">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sent" exact="@player.entity.$vgo_objects.{this.ship}.$vgo_crystal_sent + $forwarded" />
        <write_to_logbook category="general" title="'Galactic Occupations: crystals to player inventory'" text="'%1 forwarded %2 existing crystal items to player inventory. No sale or cash payment.'.[this.ship.knownname,$forwarded]" />
        <debug_text text="'GO crystals: %s forwarded %s actual inventory items to player'.[this.ship.debugname,$forwarded]" />
      </do_if>
      <return value="$forwarded" />
    </actions>
  </attention>
</aiscript>