<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.depart" version="3" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params />
  <attention min="unknown">
    <actions>
      <do_if value="this.ship == player.occupiedship or not this.ship.isplayerowned">
        <return value="false" />
      </do_if>
      <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_crystal_shop_deployed and @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_shop_actor.exists and not @player.entity.$vgo_objects.{this.ship}.$vgo_crystal_shop_actor.room.hascontext.{this.ship}">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Waiting for the crystal representative to physically return before departure'" />
        <return value="false" />
      </do_if>
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_service_dock" />
      <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_service_dock_until" />
      <do_if value="not this.ship.dock and not this.ship.parkedat">
        <return value="true" />
      </do_if>
      <do_if value="this.ship == player.occupiedship or not this.ship.isplayerowned">
        <return value="false" />
      </do_if>
      <set_value name="$previous_status" exact="@player.entity.$vgo_objects.{this.ship}.$vgo_status" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="'Undocking for occupation travel'" />
      <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_deadline" exact="player.age + 5min" />
      <run_script name="'move.undock'">
        <param name="skipwait" value="true" />
      </run_script>
      <do_if value="not this.ship.dock and not this.ship.parkedat">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="$previous_status" />
      </do_if>
      <return value="not this.ship.dock and not this.ship.parkedat" />
    </actions>
  </attention>
</aiscript>
