<?xml version='1.0' encoding='UTF-8'?>
<aiscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="vardath.go.recordresult" version="1" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="outcome" />
    <param name="amount" default="0Cr" />
  </params>
  <attention min="unknown">
    <actions>
      <set_value name="$job" exact="player.entity.$vgo_objects.{this.ship}.$vgo_job" />
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_stats?">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats" exact="table[]" />
      </do_if>
      <do_if value="not player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}?">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}" exact="table[]" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$started" exact="0" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$completed" exact="0" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$deferred" exact="0" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$income" exact="0Cr" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$since" exact="player.age" />
      </do_if>
      <do_if value="$outcome == 'started'">
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$started" exact="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$started + 1" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_attempt_open" exact="true" />
      </do_if>
      <do_elseif value="$outcome == 'completed'">
        <do_if value="@player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_serial == player.entity.$vgo_objects.{this.ship}.$vgo_serial">
          <return />
        </do_if>
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_serial" exact="player.entity.$vgo_objects.{this.ship}.$vgo_serial" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$completed" exact="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$completed + 1" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_success" exact="player.entity.$vgo_objects.{this.ship}.$vgo_result" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_success_time" exact="player.age" />
        <remove_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_exit" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_attempt_open" exact="false" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_status" exact="player.entity.$vgo_objects.{this.ship}.$vgo_result" />
        <write_to_logbook category="general" title="'Galactic Occupations: work completed'" text="'%1 completed %2: %3'.[this.ship.knownname, readtext.{191180}.{100 + $job}, player.entity.$vgo_objects.{this.ship}.$vgo_result]" />
        <debug_text text="'GO completed: %s | %s | %s'.[this.ship.debugname, readtext.{191180}.{100 + $job}, player.entity.$vgo_objects.{this.ship}.$vgo_result]" />
      </do_elseif>
      <do_elseif value="$outcome == 'deferred' and @player.entity.$vgo_objects.{this.ship}.$vgo_attempt_open">
        <!-- A sightseeing stop or a paused convoy is progress, not a completed paid contract. -->
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$deferred" exact="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$deferred + 1" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$last_exit" exact="player.entity.$vgo_objects.{this.ship}.$vgo_status" />
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_attempt_open" exact="false" />
      </do_elseif>
      <do_elseif value="$outcome == 'payment' and $amount gt 0Cr">
        <!-- Records the already observed balance increase. This helper cannot create income. -->
        <set_value name="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$income" exact="player.entity.$vgo_objects.{this.ship}.$vgo_stats.{$job}.$income + $amount" />
      </do_elseif>
    </actions>
  </attention>
</aiscript>
