extends RefCounted
## Buildable residential infrastructure, distinct from factories.
## X4-like physical workforce capacity and real station power upkeep are
## operated through the game's list-based construction and cargo economy.
## No residents, children, recruits, food, water, medical stock or schools are
## generated by these modules; those are later, source-backed systems.

const DATA_PATH := "res://data/habitation.json"
const VERSION := 1
const SERVICE_INTERVAL := 60
const MAX_CAPACITY := 1000000


func _definitions() -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	if not parsed is Dictionary or parsed.get("schema_version") != 1 or not parsed.get("modules") is Array or parsed.modules.size() != 3:
		return {}
	var catalog: Dictionary = {}
	for entry in parsed.modules:
		if not entry is Dictionary or not entry.get("id") is String or not entry.get("name") is String or not entry.get("environment") is String or catalog.has(entry.id):
			return {}
		if not entry.id in ["crew_habitat", "family_habitat", "adaptive_habitat"]:
			return {}
		if int(entry.get("capacity", 0)) < 1 or int(entry.get("energy_per_60", 0)) < 1 or not entry.get("blueprint") is Dictionary:
			return {}
		var bill: Dictionary = entry.blueprint
		if int(bill.get("fee", 0)) < 1 or int(bill.get("ticks", 0)) < 1 or int(bill.get("storage", 0)) < 1 or not bill.get("materials") is Dictionary or int(bill.materials.get("alloy_plates", 0)) < 1 or int(bill.materials.get("energy_cells", 0)) < 1:
			return {}
		catalog[entry.id] = {"id":str(entry.id), "name":str(entry.name), "capacity":int(entry.capacity), "energy_per_60":int(entry.energy_per_60), "environment":str(entry.environment)}
	return catalog


func prepare(target: Dictionary) -> Error:
	if target.has("habitation_version"):
		return OK if int(target.habitation_version) == VERSION and target.get("habitation_catalog") is Dictionary else ERR_UNAVAILABLE
	if target.has("habitation_catalog") or not target.has("population_version") or not target.has("construction_blueprints"):
		return ERR_INVALID_DATA
	var catalog: Dictionary = _definitions()
	if catalog.size() != 3:
		return ERR_INVALID_DATA
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
	for id in catalog:
		if target.construction_blueprints.has(id):
			return ERR_ALREADY_IN_USE
		for recipe in target.recipes:
			if recipe.id == id:
				return ERR_ALREADY_IN_USE
	for entry in parsed.modules:
		target.construction_blueprints[entry.id] = entry.blueprint.duplicate(true)
	target["habitation_catalog"] = catalog
	target["habitation_version"] = VERSION
	for station in target.stations:
		station["habitation"] = []
	for cohort in target.population.stations.values():
		cohort.hab_capacity = 0
		cohort.housing_status = "No habitat"
	return OK


func is_habitat(world: RefCounted, module_id: String) -> bool:
	return world.state.has("habitation_catalog") and world.state.habitation_catalog.has(module_id)


func on_commission(world: RefCounted, station_id: String, module_id: String) -> bool:
	if not is_habitat(world, module_id):
		return false
	var station: Dictionary = world._find_station(station_id)
	if station.is_empty():
		return false
	var module: Dictionary = world.state.habitation_catalog[module_id]
	var record: Dictionary = world.population.station_cohort(world, station_id)
	if record.is_empty() or int(record.hab_capacity) + int(module.capacity) > MAX_CAPACITY:
		return false
	station.habitation.append({"id":module_id, "status":"Awaiting power", "powered":false, "cycles":0})
	_refresh(world, station)
	return true


func physical_capacity(station: Dictionary, catalog: Dictionary) -> int:
	var result := 0
	for module in station.get("habitation", []):
		result += int(catalog.get(module.id, {}).get("capacity", 0))
	return result


func operational_capacity(station: Dictionary, catalog: Dictionary) -> int:
	var result := 0
	for module in station.get("habitation", []):
		if bool(module.powered):
			result += int(catalog.get(module.id, {}).get("capacity", 0))
	return result


func maintenance_per_60(station: Dictionary, catalog: Dictionary) -> int:
	var result := 0
	for module in station.get("habitation", []):
		result += int(catalog.get(module.id, {}).get("energy_per_60", 0))
	return result


func _refresh(world: RefCounted, station: Dictionary) -> void:
	var record: Dictionary = world.population.station_cohort(world, str(station.id))
	if record.is_empty():
		return
	var total: int = physical_capacity(station, world.state.habitation_catalog)
	var powered: int = operational_capacity(station, world.state.habitation_catalog)
	record.hab_capacity = total
	if total == 0:
		record.housing_status = "No habitat"
	elif powered == total:
		record.housing_status = "Powered"
	elif powered > 0:
		record.housing_status = "Partially powered"
	else:
		record.housing_status = "Unpowered"


func tick(world: RefCounted) -> void:
	if int(world.state.tick) % SERVICE_INTERVAL != 0:
		return
	for station in world.state.stations:
		for module in station.get("habitation", []):
			var definition: Dictionary = world.state.habitation_catalog.get(str(module.id), {})
			if definition.is_empty():
				continue
			var required: int = int(definition.energy_per_60)
			if int(station.stock.get("energy_cells", 0)) >= required:
				station.stock.energy_cells = int(station.stock.energy_cells) - required
				module.powered = true
				module.status = "Powered"
				module.cycles = int(module.cycles) + 1
			else:
				module.powered = false
				module.status = "Needs Energy Cells"
		_refresh(world, station)
